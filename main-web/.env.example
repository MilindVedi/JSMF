# Copy to .env.local. Both are gitignored.

# The JSMF backend API, proxied at /api by src/middleware.ts.
BACKEND_API_URL=http://localhost:4000

# The one public address this site is published at (canonical URL, Open Graph).
# Set on every deployed environment: https://jsmf.me
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# The PDF store — where the planner that comes with a seat appears, and where
# "Explore resources" links. https://store.jsmf.me when deployed.
NEXT_PUBLIC_STORE_URL=http://localhost:3001

# TEMPORARY — only while Razorpay is still reviewing this website.
# A Razorpay-hosted Payment Page URL (https://rzp.io/rzp/...). When set, the
# Reserve buttons open it instead of this site's own checkout, and /prep-kit
# becomes a shareable page for Telegram. Leave EMPTY for the real flow:
# accounts, seat counts, entitlements and emails all work normally again the
# moment this is cleared. Delete once the site is approved.
EXTERNAL_CHECKOUT_URL=
