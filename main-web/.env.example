# Copy to .env.local. Both are gitignored.

# The JSMF backend API, proxied at /api by src/middleware.ts.
BACKEND_API_URL=http://localhost:4000

# The one public address this site is published at (canonical URL, Open Graph).
# Set on every deployed environment: https://jsmf.me
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# The PDF store — where the planner that comes with a seat appears, and where
# "Explore resources" links. https://resources.jsmf.me when deployed.
NEXT_PUBLIC_STORE_URL=http://localhost:3001

# TEMPORARY — only while Razorpay is still reviewing this website.
# A Razorpay-hosted Payment Page URL (https://rzp.io/rzp/...). When set, the
# Reserve buttons open it instead of this site's own checkout, and /prep-kit
# becomes a shareable page for Telegram. Leave EMPTY for the real flow:
# accounts, seat counts, entitlements and emails all work normally again the
# moment this is cleared. Delete once the site is approved.
EXTERNAL_CHECKOUT_URL=

# Where "Contact us" and every mailto link on this site reaches. Unset falls
# back to support@jsmf.me. Change for a different brand or routing address.
NEXT_PUBLIC_SUPPORT_EMAIL=support@jsmf.me

# First-party activity analytics (page views and the booking funnel, sent to
# this site's own /api/analytics/events). Unset or anything but "false" = on.
# "false" removes every tracking call from the page. NEXT_PUBLIC_ values are
# inlined at BUILD time, so changing this needs a rebuild — to stop collection
# without one, set ANALYTICS_ENABLED=false on the backend instead (the endpoint
# then accepts and discards everything).
# NEXT_PUBLIC_ANALYTICS_ENABLED=true

# The Med Prep site (PYQ practice) — where the header's "Med Prep" link goes,
# while Admin -> Settings has it switched on. Unset falls back to
# https://prep.jsmf.me.
NEXT_PUBLIC_MED_PREP_URL=https://prep.jsmf.me
