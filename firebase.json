{
  "hosting": [
    {
      "target": "main",
      "public": "public",
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "jsmf-web-main",
            "region": "asia-south1"
          }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        }
      ]
    },
    {
      "target": "store",
      "public": "public",
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "jsmf-pdf-web",
            "region": "asia-south1"
          }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        }
      ]
    }
  ]
}
