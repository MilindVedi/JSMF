// JSMF PDF & digital content platform — database schema.
//
// This file implements docs/pdf-platform/03-data-model.md. Read that document
// for the reasoning behind the non-obvious decisions here; the comments below
// only restate a rule where getting it wrong would be silent and expensive.
//
// Two classes of constraint cannot be expressed in Prisma's schema language and
// live in prisma/migrations/*/constraints.sql instead — partial unique indexes
// and CHECK constraints. They are load-bearing, not decorative: see that file.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
  schemas    = ["public", "pyq"]
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@schema("public")
}

model User {
  id                    String           @id @default(uuid(7)) @db.Uuid
  // citext: "Milind@x.com" and "milind@x.com" must never become two accounts.
  // Nullable: an account created with a mobile number has no email until one
  // is added. Postgres allows any number of NULLs under a unique index, so
  // uniqueness still holds for every address that does exist.
  email                 String?          @unique @db.Citext
  emailVerifiedAt       DateTime?        @map("email_verified_at") @db.Timestamptz(6)
  /// E.164 digits without the `+` (`919876543210`), always written through
  /// `normalisePhoneNumber` — one spelling per person, or unique means nothing.
  phone                 String?          @unique @db.VarChar(20)
  /// Set only when a one-time code sent to `phone` came back. Every path that
  /// writes `phone` today verifies it, but the invariant is recorded here
  /// rather than implied, so a future admin edit cannot quietly break it.
  phoneVerifiedAt       DateTime?        @map("phone_verified_at") @db.Timestamptz(6)
  name                  String           @db.VarChar(120)
  // No avatarUrl column: an avatar is a file we host, addressed the same way
  // as every other stored file (provider + object key), never a raw URL —
  // both null together when no avatar has been set.
  avatarStorageProvider StorageProvider? @map("avatar_storage_provider")
  avatarObjectKey       String?          @map("avatar_object_key")
  // Nullable: an OAuth-only account has no password.
  passwordHash          String?          @map("password_hash")
  /// Profile answers asked once, right after email signup. `contactPhone` is
  /// what the person typed, unverified (`919876543210`) — deliberately not
  /// `phone`, which is a verified sign-in identifier and unique.
  contactPhone          String?          @map("contact_phone") @db.VarChar(20)
  /// Plain text from EXAM_OPTIONS / STAGE_OPTIONS, like a session registration.
  preparingFor          String?          @map("preparing_for") @db.VarChar(40)
  currentStage          String?          @map("current_stage") @db.VarChar(40)
  profileCompletedAt    DateTime?        @map("profile_completed_at") @db.Timestamptz(6)
  status                UserStatus       @default(ACTIVE)
  lastLoginAt           DateTime?        @map("last_login_at") @db.Timestamptz(6)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles                  UserRole[]
  refreshTokens          RefreshToken[]
  oauthAccounts          OAuthAccount[]
  verificationCodes      VerificationCode[]
  authoredProducts       Product[]                 @relation("ProductAuthor")
  createdProducts        Product[]                 @relation("ProductCreatedBy")
  updatedProducts        Product[]                 @relation("ProductUpdatedBy")
  uploadedAssets         ProductAsset[]
  uploads                Upload[]
  orders                 Order[]
  entitlements           Entitlement[]
  libraryBookmarks       LibraryBookmark[]
  readingProgress        ReadingProgress[]
  grantedRoles           UserRole[]                @relation("RoleGrantedBy")
  initiatedRefunds       Refund[]
  accessEvents           ContentAccessEvent[]
  auditLogs              AuditLog[]
  publisherProfile       PublisherProfile?
  couponRedemptions      CouponRedemption[]
  sessionRegistrations   SessionRegistration[]
  bundleDeliveries       SessionBundleDelivery[]
  dateAnnouncements      SessionDateAnnouncement[]
  sessionDetailReceipts  SessionDetailReceipt[]
  sessionDetailEmails    SessionDetailEmail[]
  sessionMaterialsAdded  SessionMaterial[]         @relation("SessionMaterialAddedBy")
  sessionMaterialNotices SessionMaterialNotice[]
  sessionTestimonials    SessionTestimonial[]
  practiceSessions       PracticeSession[]
  pyqAttempts            Attempt[]
  pyqBookmarks           Bookmark[]
  pyqReports             QuestionReport[]
  pyqReportsResolved     QuestionReport[]          @relation("QuestionReportResolver")
  pyqCollections         QuestionCollection[]
  pyqPreferences         PyqPreference?
  pyqQuestionStates      UserQuestionState[]
  pyqDailyActivity       UserDailyActivity[]
  legalAcceptances       LegalAcceptance[]
  legalVersionsCreated   LegalDocumentVersion[]    @relation("LegalVersionCreatedBy")
  legalVersionsPublished LegalDocumentVersion[]    @relation("LegalVersionPublishedBy")
  analyticsEvents        AnalyticsEvent[]
  mentorshipBookings     MentorshipBooking[]
  offlineSales           OfflineSale[]             @relation("OfflineSaleBuyer")
  offlineSalesRecorded   OfflineSale[]             @relation("OfflineSaleRecordedBy")
  feedbackFormsCreated   FeedbackForm[]            @relation("FeedbackFormCreatedBy")
  feedbackInvites        FeedbackInvite[]
  feedbackResponses      FeedbackResponse[]
  feedbackHighlights     FeedbackHighlight[]       @relation("FeedbackHighlightCreatedBy")
  noSessionQuotes        NoSessionQuote[]          @relation("NoSessionQuoteCreatedBy")

  @@map("users")
  @@schema("public")
}

/// Roles are a table rather than a column on User because one person is
/// realistically both ADMIN and EDUCATOR, which a single enum column cannot
/// express without a migration the first time it happens.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(40) // ADMIN | EDUCATOR | STUDENT
  name        String   @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users UserRole[]

  @@map("roles")
  @@schema("public")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedById String?  @map("granted_by") @db.Uuid

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("public")
}

/// Why a refresh token is revoked. The distinction is not bookkeeping: telling
/// a normal rotation apart from a replay is exactly what reuse detection needs.
enum RefreshTokenRevokedReason {
  /// Normal rotation — this token was exchanged for a successor.
  ROTATED
  /// An already-rotated token was presented again. Treated as a stolen-token
  /// replay: the whole family is revoked.
  REUSE_DETECTED
  LOGOUT
  ADMIN_REVOKED
  /// The account's password was reset or changed. Every live session is
  /// revoked, because a reset is often a response to someone else holding the
  /// account — leaving their refresh tokens alive would make it cosmetic.
  PASSWORD_CHANGED

  @@schema("public")
}

/// Refresh tokens rotate: each one is single-use, and exchanging it issues a
/// successor in the same family.
///
/// The family is what makes theft survivable. If a token that has already been
/// rotated is presented again, either the legitimate client or an attacker is
/// replaying it — and there is no way to tell which. So every token in that
/// family is revoked at once and the user re-authenticates. Without a family
/// id, a stolen token could be refreshed indefinitely alongside the real
/// session and nothing would ever notice.
model RefreshToken {
  id            String                     @id @default(uuid(7)) @db.Uuid
  userId        String                     @map("user_id") @db.Uuid
  /// Every token descended from a single login shares this id.
  tokenFamilyId String                     @map("token_family_id") @db.Uuid
  // The raw token is never stored — only a SHA-256 hash of it.
  tokenHash     String                     @unique @map("token_hash")
  expiresAt     DateTime                   @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?                  @map("revoked_at") @db.Timestamptz(6)
  revokedReason RefreshTokenRevokedReason? @map("revoked_reason")
  userAgent     String?                    @map("user_agent")
  ip            String?                    @db.Inet
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([tokenFamilyId])
  @@map("refresh_tokens")
  @@schema("public")
}

/// Identity providers a JSMF account can be linked to. Platform-wide: the same
/// linkage serves the PDF platform, the PYQ application, and the mobile apps,
/// because identity is one service for all of them.
enum OAuthProvider {
  GOOGLE

  @@schema("public")
}

/// A third-party identity linked to a JSMF account.
///
/// Separate from `users` rather than a `google_id` column, because an account
/// may eventually link several providers (Google today, Apple on iOS later),
/// and because the provider's own user id — not the email — is the stable
/// identifier. Emails change hands; `sub` does not.
model OAuthAccount {
  id             String        @id @default(uuid(7)) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  provider       OAuthProvider
  /// The provider's immutable subject identifier (Google's `sub`). Never the
  /// email: Google explicitly documents that email is not a stable key.
  providerUserId String        @map("provider_user_id") @db.VarChar(255)
  /// The email the provider asserted at link time, kept for support and audit
  /// only — authorisation never reads it.
  email          String?       @db.VarChar(255)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt    DateTime?     @map("last_login_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One JSMF account per provider identity, and one link per provider per
  /// user — so a Google account cannot be attached to two JSMF accounts.
  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
  @@schema("public")
}

/// What a one-time code authorises. Kept as an enum on one table rather than a
/// table per flow, because every one of these is the same mechanism — a hashed,
/// expiring, single-use, attempt-limited secret bound to a subject — and only
/// the meaning differs.
enum VerificationPurpose {
  /// An existing admin invited this address to become an admin. Emailed as a
  /// link directly to the invitee — there is no public way to request one, so
  /// creating an admin is always an authenticated act by an existing admin.
  ADMIN_INVITATION
  /// Hands a completed OAuth session back to a browser without putting tokens
  /// in a URL. Never emailed.
  OAUTH_HANDOFF
  EMAIL_VERIFICATION
  PASSWORD_RESET
  /// A code sent to a mobile number to sign in, or to begin signing up — the
  /// same code serves both, so nobody learns whether a number has an account
  /// without controlling the phone.
  PHONE_SIGN_IN
  /// Issued after PHONE_SIGN_IN succeeds for a number with no account: lets
  /// the person choose a name without being sent a second code.
  PHONE_REGISTRATION
  /// Adding a verified mobile number to an account that is already signed in.
  PHONE_LINK

  @@schema("public")
}

/// A single-use, expiring secret.
///
/// Generic on purpose: admin-registration OTPs, OAuth handoff codes, and the
/// email-verification and password-reset flows that will follow are the same
/// primitive with different meanings. Building four near-identical tables would
/// mean four places to get expiry, attempt-limiting and single-use wrong.
///
/// The code itself is never stored — only a hash, verified through the same
/// `PasswordHasher` port used for passwords. A six-digit code has a small
/// keyspace, so `maxAttempts` and `expiresAt`, not hash strength, are what make
/// guessing impractical.
model VerificationCode {
  id          String              @id @default(uuid(7)) @db.Uuid
  purpose     VerificationPurpose
  /// What the code is about: the applicant's email for ADMIN_REGISTRATION, the
  /// user id for OAUTH_HANDOFF. Not a foreign key — for admin registration the
  /// subject is an email that has no account yet, which is the entire point.
  subject     String              @db.VarChar(255)
  codeHash    String              @map("code_hash")
  /// Where the code was actually delivered. Null when it is not emailed at all
  /// (OAUTH_HANDOFF). For ADMIN_REGISTRATION this is the approver's address,
  /// deliberately different from `subject` — that difference is the gate.
  sentToEmail String?             @map("sent_to_email") @db.VarChar(255)
  /// Set once the code resolves to a real account (OAUTH_HANDOFF).
  userId      String?             @map("user_id") @db.Uuid
  /// Flow-specific payload — e.g. the applicant's requested name, or which
  /// front-end the OAuth flow must return to.
  metadata    Json                @default("{}")
  expiresAt   DateTime            @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?           @map("consumed_at") @db.Timestamptz(6)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5) @map("max_attempts")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdIp   String?             @map("created_ip") @db.Inet

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Finding the live code for a subject is the only lookup this table serves.
  @@index([purpose, subject, expiresAt])
  @@map("verification_codes")
  @@schema("public")
}

/// Why a send ended the way it did.
///
/// QUOTA_EXCEEDED is split out from FAILED because it is the one failure that
/// is neither a bug nor transient noise: the plan's allowance is simply gone,
/// and the answer is to upgrade rather than to retry or investigate.
enum EmailDeliveryStatus {
  SENT
  FAILED
  QUOTA_EXCEEDED

  @@schema("public")
}

/// One row per attempted send.
///
/// Exists because no provider reports remaining allowance. Resend's API returns
/// only a per-second request rate limit (`ratelimit-remaining: 9`) and says
/// nothing about the daily or monthly cap that actually runs out, so the counts
/// that decide free-versus-paid have to be kept here.
///
/// Also the record of what was *not* delivered: a signup or purchase is
/// deliberately allowed to succeed when its email fails, and without this table
/// that failure would leave no trace at all.
model EmailDelivery {
  id                String              @id @default(uuid(7)) @db.Uuid
  /// Which adapter ran: log, smtp or resend.
  provider          String              @db.VarChar(32)
  /// The stable slug the caller passed, e.g. `admin-invitation`. Groups sends
  /// by kind, so one flow's volume can be told apart from another's.
  tag               String?             @db.VarChar(64)
  recipient         String              @db.VarChar(255)
  status            EmailDeliveryStatus
  /// The provider's own id, when it gave one — for tracing a delivery later.
  providerMessageId String?             @map("provider_message_id") @db.VarChar(255)
  /// The provider's diagnosis, kept for operators. Never returned to a caller:
  /// "Resend daily limit exceeded" is an internal detail, not a user's problem.
  error             String?             @db.VarChar(500)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Counting sends within a day or a month is the only lookup this table
  /// serves; `status` is in the index so quota-exceeded rows can be counted
  /// without reading the table.
  @@index([createdAt, status])
  @@map("email_deliveries")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// V1 only ever writes PDF. The other values exist so that adding video,
/// course, and bundle products later is a new row rather than a new table —
/// which is what keeps orders, payments, entitlements and the library code
/// completely unchanged when they arrive.
enum ProductType {
  PDF
  VIDEO
  COURSE
  BUNDLE
  /// A paid live session sold on the main website (jsmf.me). A product like
  /// any other, so orders, Razorpay, refunds, receipts and the audit trail
  /// need no second implementation; everything only a session has lives in
  /// `live_sessions`. Never listed in the PDF storefront.
  LIVE_SESSION
  /// A one-to-one mentorship call booked for a time slot on the main website.
  /// Bought repeatedly (one order per call), so it never grants a library
  /// entitlement; the booking row in `mentorship_bookings` is what the buyer
  /// holds. Never listed in the PDF storefront.
  MENTORSHIP

  @@schema("public")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED // reversible
  ARCHIVED // the soft delete

  @@schema("public")
}

/// Explicit rather than inferred from `price == 0`, so that "this is free" is a
/// stated intent and a zero-priced PAID product is a constraint violation
/// instead of a silent giveaway.
enum AccessType {
  FREE
  PAID

  @@schema("public")
}

model Product {
  id                   String         @id @default(uuid(7)) @db.Uuid
  type                 ProductType
  /// The public URL (/p/{slug}). Effectively immutable once published: this
  /// link lives permanently in YouTube descriptions, so changing it must be a
  /// deliberate act with a redirect, never a side effect of editing a title.
  slug                 String         @unique @db.VarChar(160)
  title                String         @db.VarChar(200)
  subtitle             String?        @db.VarChar(300)
  description          String?
  // No coverImageUrl column, deliberately: the cover is a ProductAsset row
  // (kind = COVER_IMAGE) like every other file, not a URL. However the image
  // arrives — an admin upload, or a URL an admin pastes in — the service layer
  // always re-uploads it to our own storage first and records the resulting
  // object_key; a third-party URL is never written to a row directly. This
  // also means the cover gets the same free win the primary PDF already has:
  // replacing it is a new asset version, not a destructive overwrite, and
  // "exactly one current cover" falls out of the existing
  // product_assets_current_unique partial index with no extra constraint.
  status               ProductStatus  @default(DRAFT)
  accessType           AccessType     @map("access_type")
  priceAmountMinor     BigInt         @default(0) @map("price_amount_minor")
  compareAtAmountMinor BigInt?        @map("compare_at_amount_minor")
  currency             String         @default("INR") @db.Char(3)
  authorUserId         String?        @map("author_user_id") @db.Uuid
  language             String         @default("en") @db.VarChar(10)
  /// Escape hatch for type-specific fields (a video's duration). Never used for
  /// anything filtered or queried — those become taxonomy terms or real columns.
  metadata             Json           @default("{}")
  /// Position in the storefront's "Featured resources" strip, or NULL for the
  /// vast majority of products, which are not featured. Nullable rather than a
  /// `featured` boolean plus a separate position: two columns would allow the
  /// meaningless state "featured, no position", and the admin screen would
  /// then have to decide what that means. One column cannot be inconsistent.
  ///
  /// There is no "how many to show" setting anywhere: the count is however
  /// many products carry a position. What the admin arranges is exactly what
  /// the storefront renders, which is the only version of this that cannot
  /// drift.
  featuredOrder        Int?           @map("featured_order")
  /// "Show in store". False keeps a product out of the public store — browse,
  /// search, the featured strip and its /p page — and stops anyone buying or
  /// freely claiming it, while everyone who already holds it keeps it in their
  /// library. For material handed out to a live session's seat holders that is
  /// not for sale on its own. Independent of `status`: an unlisted product is
  /// usually PUBLISHED.
  listed               Boolean        @default(true)
  /// Whether buyers may download the file, or only read it in the reader.
  /// INHERIT follows the store-wide switch (platform_settings.downloads_enabled);
  /// the other two override it for this product alone.
  downloadPolicy       DownloadPolicy @default(INHERIT) @map("download_policy")
  /// When set, the "Read sample" PDF is cut by the server from the first N
  /// pages of the current file — and cut again whenever that file is
  /// replaced. Null when the sample is a file an admin uploaded, or there is
  /// none. Never more pages than the file has, less one.
  samplePageCount      Int?           @map("sample_page_count")
  publishedAt          DateTime?      @map("published_at") @db.Timestamptz(6)
  createdById          String?        @map("created_by") @db.Uuid
  updatedById          String?        @map("updated_by") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?      @map("deleted_at") @db.Timestamptz(6)

  author    User? @relation("ProductAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdBy User? @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  assets             ProductAsset[]
  links              ProductLink[]
  taxonomyTerms      ProductTaxonomyTerm[]
  orderItems         OrderItem[]
  entitlements       Entitlement[]         @relation("EntitlementProduct")
  libraryBookmarks   LibraryBookmark[]
  readingProgress    ReadingProgress[]
  grantedVia         Entitlement[]         @relation("EntitlementSourceProduct")
  accessEvents       ContentAccessEvent[]
  bundleItems        ProductBundleItem[]   @relation("BundleParent")
  inBundles          ProductBundleItem[]   @relation("BundleChild")
  liveSession        LiveSession?
  mentorshipOffering MentorshipOffering?
  offlineSales       OfflineSale[]
  sessionMaterials   SessionMaterial[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([type])
  @@index([authorUserId])
  @@index([featuredOrder])
  @@map("products")
  @@schema("public")
}

enum AssetKind {
  PRIMARY_FILE
  SAMPLE_PREVIEW
  ATTACHMENT
  /// The product's cover/thumbnail. The one PUBLIC kind in this table — every
  /// other kind is private and entitlement-gated. Which bucket a row's `kind`
  /// belongs in (public vs. private) is a service-layer rule, not a column:
  /// see docs/pdf-platform/02-architecture.md, "Storage and download access".
  COVER_IMAGE

  @@schema("public")
}

/// Where an asset physically lives. Recorded per asset rather than assumed
/// globally, so that migrating providers is a background job that moves files
/// and updates rows — not a flag day where every existing asset's location
/// becomes a lie the moment the config changes.
enum StorageProvider {
  /// The intended production provider.
  CLOUDINARY
  /// Local-disk adapter, used in development before any cloud account exists.
  LOCAL
  /// Supported destinations, no adapter written yet — listed because the point
  /// of this column is that the provider is data, not a structural assumption.
  GCS
  S3

  @@schema("public")
}

/// Versioned on purpose. The doctor will find a typo and re-upload; a new row
/// (version 2, isCurrent true) means buyers automatically get the corrected
/// file, the previous file is retained for audit, and no download link breaks.
/// Overwriting the object in place would destroy the only copy of what people
/// actually paid for.
///
/// product: Restrict, not Cascade — the product this asset belongs to is
/// never supposed to be hard-deleted at all (the product only ever gets
/// archived), so this is a backstop against a bug or a stray admin action
/// doing it anyway, not a case the application is expected to hit.
model ProductAsset {
  id                 String          @id @default(uuid(7)) @db.Uuid
  productId          String          @map("product_id") @db.Uuid
  kind               AssetKind
  /// Deliberately no default: the writer always knows which provider it just
  /// uploaded to, and a default would let a forgotten field silently record a
  /// location the file is not actually at.
  storageProvider    StorageProvider @map("storage_provider")
  bucket             String          @db.VarChar(255)
  objectKey          String          @map("object_key")
  originalFilename   String?         @map("original_filename") @db.VarChar(255)
  mimeType           String?         @map("mime_type") @db.VarChar(120)
  sizeBytes          BigInt?         @map("size_bytes")
  /// Detects a corrupted upload, and an accidental re-upload of an identical file.
  /// Null for a file uploaded straight to storage (AssetUpload): the bytes never
  /// pass through this app, so only the checksum the provider computed exists.
  checksumSha256     String?         @map("checksum_sha256") @db.VarChar(64)
  /// MD5 (hex) as the storage provider computed it, or this app on the
  /// multipart path. What the "identical to the current version" check compares
  /// when both rows have it; GCS reports it for every non-composite object.
  checksumMd5        String?         @map("checksum_md5") @db.VarChar(32)
  pageCount          Int?            @map("page_count")
  /// For a sample cut by the server: the file it was cut from. Says whether
  /// the sample is still the current file's first pages. Null for anything
  /// uploaded.
  derivedFromAssetId String?         @map("derived_from_asset_id") @db.Uuid
  version            Int             @default(1)
  isCurrent          Boolean         @default(true) @map("is_current")
  uploadedById       String?         @map("uploaded_by") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  product         Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  uploadedBy      User?                @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  accessEvents    ContentAccessEvent[]
  derivedFrom     ProductAsset?        @relation("AssetDerivedFrom", fields: [derivedFromAssetId], references: [id], onDelete: SetNull)
  derivatives     ProductAsset[]       @relation("AssetDerivedFrom")
  readingProgress ReadingProgress[]

  @@index([productId, kind, isCurrent])
  @@map("product_assets")
  @@schema("public")
}

enum UploadStatus {
  /// Session handed to the browser; the bytes may or may not have arrived yet.
  PENDING
  /// Checked and recorded by its purpose (`result_id`).
  COMPLETED
  /// Cancelled, or refused at completion (`failure_reason`).
  ABORTED
  /// Never completed in time; the sweep removed whatever reached storage.
  EXPIRED

  @@schema("public")
}

/// A file a browser sends straight to object storage, not through this app —
/// so its size is bounded by the provider (5 TB on GCS), not by Cloud Run's
/// 32 MiB request cap or an instance's memory. Every kind of upload uses it:
/// `purpose` names what the file is for ("product.primary_file",
/// "session.testimonial", later "user.avatar"), and the module that owns that
/// purpose decides who may upload, what is allowed, and what a completed
/// upload becomes (UploadPurposeRegistry).
///
/// The row is written *before* any byte moves, with the object key this app
/// chose; the browser gets a session bound to exactly that key, size and type.
/// Completing it reads the object's metadata from storage and only then hands
/// it to the purpose. A row left PENDING past `expires_at` is how the sweep
/// finds abandoned uploads, whose bytes would otherwise sit in the bucket with
/// nothing pointing at them.
///
/// `result_id` is deliberately not a foreign key: what an upload becomes
/// depends on its purpose (a product_assets row, a session_testimonials row).
model Upload {
  id               String          @id @default(uuid(7)) @db.Uuid
  purpose          String          @db.VarChar(60)
  /// What it is for: the product, session or user the purpose attaches it to.
  targetId         String?         @map("target_id") @db.Uuid
  /// The purpose's own options from the start of the upload (a section, a page count).
  context          Json?
  /// Where the browser's bytes went.
  storageProvider  StorageProvider @map("storage_provider")
  bucket           String          @db.VarChar(255)
  objectKey        String          @map("object_key")
  /// True when that is a private staging key: a file bound for the public
  /// bucket is checked there first, and copied out only once accepted, so an
  /// unchecked file is never publicly readable.
  staged           Boolean         @default(false)
  originalFilename String          @map("original_filename") @db.VarChar(255)
  mimeType         String          @map("mime_type") @db.VarChar(120)
  /// What the browser declared, and what the storage session is locked to.
  sizeBytes        BigInt          @map("size_bytes")
  status           UploadStatus    @default(PENDING)
  /// Why it was refused at completion, shown to the uploader and kept for support.
  failureReason    String?         @map("failure_reason") @db.VarChar(300)
  expiresAt        DateTime        @map("expires_at") @db.Timestamptz(6)
  createdById      String?         @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt       DateTime?       @map("finished_at") @db.Timestamptz(6)
  /// The id of what the purpose recorded it as.
  resultId         String?         @map("result_id") @db.Uuid

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([storageProvider, bucket, objectKey])
  @@index([status, expiresAt])
  @@index([createdById, status])
  @@index([purpose, targetId])
  @@map("uploads")
  @@schema("public")
}

enum LinkKind {
  YOUTUBE
  INSTAGRAM
  TELEGRAM
  WEBSITE
  OTHER

  @@schema("public")
}

/// A table rather than a `youtube_url` column on Product, so that "also link
/// the Instagram reel" is data entry rather than a migration.
///
/// product: Restrict, for the same reason as ProductAsset — a Product is
/// never supposed to be hard-deleted, so this only ever fires if something
/// tries to anyway, and a curated link (the one in a YouTube description) is
/// exactly the kind of thing that should never silently vanish.
model ProductLink {
  id        String    @id @default(uuid(7)) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  kind      LinkKind
  url       String
  label     String?   @db.VarChar(160)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Soft delete, like everything else customer-facing on this platform. A
  /// link removed by mistake — or one an admin wants to temporarily hide
  /// without losing the URL and label they typed — is recoverable rather than
  /// gone.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@map("product_links")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Taxonomy — the extensibility commitment.
//
// Subject and topic are NOT columns on Product. Adding a new category kind
// ("Difficulty", "Year", "Language") later is an INSERT into taxonomies plus
// its terms: no migration, no deploy, no code change, because the admin form
// and the storefront filters are both rendered from these tables rather than
// from hardcoded fields.
// ---------------------------------------------------------------------------

model Taxonomy {
  id             String   @id @default(uuid(7)) @db.Uuid
  key            String   @unique @db.VarChar(60) // subject | topic | exam | tag ...
  name           String   @db.VarChar(120)
  description    String?
  /// Whether terms may nest (topics under subjects).
  isHierarchical Boolean  @default(false) @map("is_hierarchical")
  /// Whether a product may carry more than one term of this kind.
  isMultiSelect  Boolean  @default(true) @map("is_multi_select")
  /// Drives field order in the admin form and filter order in the storefront.
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  terms TaxonomyTerm[]

  @@map("taxonomies")
  @@schema("public")
}

/// taxonomy: Restrict, not Cascade. A taxonomy KIND (e.g. "subject") is master
/// data, and deleting one used to cascade-delete every term under it, each of
/// which cascaded again into every product tag using that term — one delete
/// statement on a single taxonomy row could have silently untagged the entire
/// catalog. Restrict means a taxonomy kind must have its terms cleared out
/// first, deliberately, one decision at a time.
model TaxonomyTerm {
  id           String    @id @default(uuid(7)) @db.Uuid
  taxonomyId   String    @map("taxonomy_id") @db.Uuid
  /// Self-referencing, and deliberately allowed to cross taxonomies: a `topic`
  /// term's parent is a `subject` term. That is what makes Subject → Topic
  /// nesting work without a bespoke table.
  parentTermId String?   @map("parent_term_id") @db.Uuid
  slug         String    @db.VarChar(120)
  name         String    @db.VarChar(160)
  description  String?
  sortOrder    Int       @default(0) @map("sort_order")
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete. A term can still only be deleted while unused (see
  /// ProductTaxonomyTerm/TaxonomyTerm's Restrict relations below) — this
  /// column is what makes that deletion recoverable rather than destroying the
  /// term's id, description and history outright.
  ///
  /// The (taxonomyId, slug) uniqueness this table needs is therefore a PARTIAL
  /// unique index scoped to WHERE deleted_at IS NULL, declared in
  /// constraints.sql — Prisma cannot express it — so that a slug freed up by a
  /// soft delete can be reused, the same reasoning as
  /// entitlements_user_product_active_unique.
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  taxonomy Taxonomy              @relation(fields: [taxonomyId], references: [id], onDelete: Restrict)
  parent   TaxonomyTerm?         @relation("TermHierarchy", fields: [parentTermId], references: [id], onDelete: SetNull)
  children TaxonomyTerm[]        @relation("TermHierarchy")
  products ProductTaxonomyTerm[]

  @@index([parentTermId])
  @@index([taxonomyId, sortOrder])
  @@map("taxonomy_terms")
  @@schema("public")
}

/// term: Restrict, not Cascade. This is the sharper edge of the taxonomy risk
/// above — deleting one term directly (e.g. "Pathology") is a far more
/// plausible admin mistake than deleting a whole taxonomy kind, and nothing
/// used to stop it from silently stripping that tag off every product that
/// had it. Restrict means a term in use must be explicitly untagged first.
model ProductTaxonomyTerm {
  productId String   @map("product_id") @db.Uuid
  termId    String   @map("term_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // product stays Cascade: this only removes the PRODUCT's own tag rows when
  // the product itself is gone, which is harmless — the risk being fixed here
  // is specifically a TERM taking every product that uses it down with it.
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  term    TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Restrict)

  @@id([productId, termId])
  @@index([termId])
  @@map("product_taxonomy_terms")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Orders & payments
// ---------------------------------------------------------------------------

enum OrderStatus {
  CREATED
  AWAITING_PAYMENT
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED

  @@schema("public")
}

model Order {
  id                  String      @id @default(uuid(7)) @db.Uuid
  /// Human-readable (JSMF-2026-000412). Support conversations need something a
  /// person can read out loud; a UUID is not that.
  orderNumber         String      @unique @map("order_number") @db.VarChar(30)
  userId              String      @map("user_id") @db.Uuid
  status              OrderStatus @default(CREATED)
  subtotalAmountMinor BigInt      @map("subtotal_amount_minor")
  /// Separated from day one so coupons do not require restructuring totals.
  discountAmountMinor BigInt      @default(0) @map("discount_amount_minor")
  /// GST will matter; retrofitting it across orders, invoices and refunds later
  /// is far more expensive than carrying a zero now.
  taxAmountMinor      BigInt      @default(0) @map("tax_amount_minor")
  totalAmountMinor    BigInt      @map("total_amount_minor")
  currency            String      @default("INR") @db.Char(3)
  /// Snapshots: a user changing their email must not rewrite the contact
  /// details on a past invoice.
  // Nullable: a buyer who signed up with a mobile number may have no email.
  // The confirmation email is skipped for them rather than the purchase refused.
  customerEmail       String?     @map("customer_email") @db.VarChar(255)
  customerPhone       String?     @map("customer_phone") @db.VarChar(20)
  couponId            String?     @map("coupon_id") @db.Uuid
  notes               Json        @default("{}")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  paidAt              DateTime?   @map("paid_at") @db.Timestamptz(6)
  cancelledAt         DateTime?   @map("cancelled_at") @db.Timestamptz(6)

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon               Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  payments             Payment[]
  refunds              Refund[]
  entitlements         Entitlement[]
  redemption           CouponRedemption?
  sessionRegistrations SessionRegistration[]
  mentorshipBooking    MentorshipBooking?
  offlineSale          OfflineSale?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("orders")
  @@schema("public")
}

/// The snapshot columns are the point of this table: if the doctor renames the
/// PDF or raises its price next month, every past invoice must still show what
/// the customer actually bought and paid. Joining live to Product for an
/// invoice would silently rewrite financial history.
model OrderItem {
  id                   String      @id @default(uuid(7)) @db.Uuid
  orderId              String      @map("order_id") @db.Uuid
  productId            String      @map("product_id") @db.Uuid
  productTitleSnapshot String      @map("product_title_snapshot") @db.VarChar(200)
  productTypeSnapshot  ProductType @map("product_type_snapshot")
  unitPriceAmountMinor BigInt      @map("unit_price_amount_minor")
  quantity             Int         @default(1)
  totalAmountMinor     BigInt      @map("total_amount_minor")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Restrict, never Cascade: a product that has been sold can never be hard
  /// deleted. This is precisely why ARCHIVED exists as a status.
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@map("order_items")
  @@schema("public")
}

enum PaymentProvider {
  RAZORPAY
  /// Development adapter: simulates the full authorize/capture/webhook cycle
  /// so the payment flow can be built and tested before Razorpay keys exist.
  STUB
  /// Money that arrived outside any provider — a direct UPI transfer, a bank
  /// transfer, cash — recorded by an admin. Nothing to refund through an API;
  /// see OfflineSale for how it was paid.
  OFFLINE

  @@schema("public")
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED

  @@schema("public")
}

/// Separate from Order because one order can have several payment attempts (a
/// failed card, then UPI), because provider payloads are large and should not
/// bloat the order row, and because a second provider later becomes a value in
/// a column rather than a schema change.
model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  provider          PaymentProvider
  providerOrderId   String?         @map("provider_order_id") @db.VarChar(120)
  /// Unique where present — the same provider payment can never be recorded
  /// twice. In Postgres, NULLs do not conflict, so this is already the partial
  /// uniqueness we want.
  providerPaymentId String?         @unique @map("provider_payment_id") @db.VarChar(120)
  providerSignature String?         @map("provider_signature")
  status            PaymentStatus   @default(CREATED)
  amountMinor       BigInt          @map("amount_minor")
  currency          String          @default("INR") @db.Char(3)
  method            String?         @db.VarChar(40) // upi | card | netbanking
  errorCode         String?         @map("error_code") @db.VarChar(80)
  errorDescription  String?         @map("error_description")
  /// Kept verbatim: when a payment is disputed, the provider's own payload is
  /// the evidence.
  rawResponse       Json?           @map("raw_response")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  capturedAt        DateTime?       @map("captured_at") @db.Timestamptz(6)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@index([providerOrderId])
  @@map("payments")
  @@schema("public")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED

  @@schema("public")
}

/// The idempotency guard, and not optional.
///
/// Razorpay retries webhooks on any non-2xx response and can deliver the same
/// event more than once even on success. Without the unique provider event id
/// recorded BEFORE processing, a retry grants a second entitlement or issues a
/// second refund. Every webhook handler writes this row first and aborts on
/// conflict.
model PaymentWebhookEvent {
  id              String             @id @default(uuid(7)) @db.Uuid
  provider        PaymentProvider
  providerEventId String             @unique @map("provider_event_id") @db.VarChar(160)
  eventType       String             @map("event_type") @db.VarChar(80)
  payload         Json
  signatureValid  Boolean            @map("signature_valid")
  status          WebhookEventStatus @default(RECEIVED)
  processingError String?            @map("processing_error")
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(6)

  @@index([provider, eventType])
  @@map("payment_webhook_events")
  @@schema("public")
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED

  @@schema("public")
}

/// How money went back to a buyer outside the payment provider.
enum ManualRefundMethod {
  UPI
  BANK_TRANSFER
  CASH
  OTHER

  @@schema("public")
}

/// One return of money on an order. Several can add up to the amount paid.
///
/// Either the provider moved the money (`providerRefundId` set) or an admin
/// did it themselves and recorded it here (`manualMethod` set) — never both.
/// Whether access was taken away is not stored here: it is a separate decision
/// the admin makes, and the order's entitlements are what record it.
model Refund {
  id               String              @id @default(uuid(7)) @db.Uuid
  paymentId        String              @map("payment_id") @db.Uuid
  orderId          String              @map("order_id") @db.Uuid
  providerRefundId String?             @unique @map("provider_refund_id") @db.VarChar(120)
  amountMinor      BigInt              @map("amount_minor")
  status           RefundStatus        @default(PENDING)
  reason           String?
  initiatedById    String?             @map("initiated_by") @db.Uuid
  rawResponse      Json?               @map("raw_response")
  /// Set only for a refund an admin made outside the provider and recorded.
  manualMethod     ManualRefundMethod? @map("manual_method")
  /// What identifies a manual refund where it happened: a UPI UTR, a bank reference.
  reference        String?             @db.VarChar(100)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// When the money actually went back. For a manual refund, the date the admin gives.
  processedAt      DateTime?           @map("processed_at") @db.Timestamptz(6)

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  initiatedBy User?   @relation(fields: [initiatedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("refunds")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Access
// ---------------------------------------------------------------------------

enum EntitlementSource {
  PURCHASE
  FREE_CLAIM
  ADMIN_GRANT
  SUBSCRIPTION
  BUNDLE
  /// A PDF attached to one day of a live session, given to its seat holders.
  /// `sourceProductId` is the session and `sourceOrderId` the seat's order, so
  /// a refund of the seat takes it back with everything else.
  SESSION_MATERIAL

  @@schema("public")
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@schema("public")
}

/// The heart of access control: every download check reads this table and only
/// this table.
///
/// A separate table rather than deriving access from paid orders, because free
/// claims, admin gifts, bundle contents, refund revocation and future
/// subscriptions all grant or remove access without a one-to-one paid order
/// behind them. One table that every path writes to means the download endpoint
/// has exactly one question to ask.
model Entitlement {
  id              String            @id @default(uuid(7)) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  source          EntitlementSource
  sourceOrderId   String?           @map("source_order_id") @db.Uuid
  /// The bundle this was granted through, when source = BUNDLE.
  sourceProductId String?           @map("source_product_id") @db.Uuid
  status          EntitlementStatus @default(ACTIVE)
  grantedAt       DateTime          @default(now()) @map("granted_at") @db.Timestamptz(6)
  /// NULL = perpetual, which is all V1 grants. Present now so subscriptions and
  /// rentals need no migration.
  expiresAt       DateTime?         @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revokedReason   String?           @map("revoked_reason")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product  @relation("EntitlementProduct", fields: [productId], references: [id], onDelete: Restrict)
  sourceOrder   Order?   @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
  sourceProduct Product? @relation("EntitlementSourceProduct", fields: [sourceProductId], references: [id], onDelete: SetNull)

  accessEvents ContentAccessEvent[]

  // NOTE: the real guarantee is a PARTIAL unique index on (user_id, product_id)
  // WHERE status = 'ACTIVE', declared in constraints.sql — Prisma cannot express
  // it. It is what makes a double-submitted payment or duplicate webhook unable
  // to produce two live grants, without relying on application code checking first.
  @@index([userId, status])
  @@index([productId])
  @@map("entitlements")
  @@schema("public")
}

/// A product the reader has bookmarked in their library, so they can find it
/// again under "Bookmarked". One row per reader and product — bookmarking
/// twice is a no-op, not a second row. Only a product the reader holds can be
/// bookmarked (checked in LibraryBookmarkService); if their access later ends
/// the row stays, but the library only lists what they still hold, so it
/// simply stops showing.
model LibraryBookmark {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("library_bookmarks")
  @@schema("public")
}

/// Why a signed link to a product's file was handed out (ContentAccessEvent).
enum ContentAccessPurpose {
  DOWNLOAD
  /// Opened in the in-browser reader.
  READ
  /// The "Read sample" preview, open to anyone.
  SAMPLE

  @@schema("public")
}

enum DownloadPolicy {
  /// Follow the store-wide switch.
  INHERIT
  ALLOWED
  BLOCKED

  @@schema("public")
}

/// Where one reader is in one product: the page to reopen at, on any device.
/// One row per (user, product), overwritten as they read. `assetId` is the
/// file version the page belongs to — a replaced file can have different
/// pages, and the reader then starts from a clamped page rather than a wrong one.
model ReadingProgress {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  assetId   String?  @map("asset_id") @db.Uuid
  /// 1-based.
  page      Int
  pageCount Int      @map("page_count")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset   ProductAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@id([userId, productId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("reading_progress")
  @@schema("public")
}

/// Written on every signed-URL mint. This is what makes download management and
/// engagement analytics possible later — and it has to be collected from day
/// one, because the expensive part of an analytics feature is the history you
/// did not record, not the chart.
///
/// `product`/`asset` are SetNull, not Cascade, and deliberately nullable: this
/// is an audit log, and an audit log that can be erased by deleting the thing
/// it was auditing defeats its own purpose. A free product with no order and
/// no entitlement behind it has nothing else stopping it from being deleted —
/// SetNull is what keeps its download history intact even then; only the
/// pointer to the now-gone product/asset is cleared, not the event itself.
model ContentAccessEvent {
  id                 String               @id @default(uuid(7)) @db.Uuid
  /// Null for an anonymous free download.
  userId             String?              @map("user_id") @db.Uuid
  productId          String?              @map("product_id") @db.Uuid
  assetId            String?              @map("asset_id") @db.Uuid
  entitlementId      String?              @map("entitlement_id") @db.Uuid
  signedUrlExpiresAt DateTime             @map("signed_url_expires_at") @db.Timestamptz(6)
  /// What the link was for. Rows from before the reader are all downloads.
  purpose            ContentAccessPurpose @default(DOWNLOAD)
  ip                 String?              @db.Inet
  userAgent          String?              @map("user_agent")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  asset       ProductAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  entitlement Entitlement?  @relation(fields: [entitlementId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("content_access_events")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Designed, deliberately NOT built in V1.
//
// These tables exist in the schema so their arrival is additive rather than a
// reshaping of everything above. No V1 code path writes to them.
// ---------------------------------------------------------------------------

enum CouponDiscountType {
  PERCENT
  FIXED

  @@schema("public")
}

enum CouponStatus {
  ACTIVE
  DISABLED
  EXPIRED

  @@schema("public")
}

model Coupon {
  id                  String             @id @default(uuid(7)) @db.Uuid
  code                String             @unique @db.Citext
  discountType        CouponDiscountType @map("discount_type")
  discountValue       Int                @map("discount_value") // percent, or minor units when FIXED
  maxRedemptions      Int?               @map("max_redemptions")
  perUserLimit        Int?               @map("per_user_limit")
  minOrderAmountMinor BigInt?            @map("min_order_amount_minor")
  /// Product ids or taxonomy term ids this coupon is restricted to.
  appliesTo           Json               @default("{}") @map("applies_to")
  startsAt            DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime?          @map("ends_at") @db.Timestamptz(6)
  status              CouponStatus       @default(ACTIVE)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders      Order[]
  redemptions CouponRedemption[]

  @@map("coupons")
  @@schema("public")
}

model CouponRedemption {
  id                  String   @id @default(uuid(7)) @db.Uuid
  couponId            String   @map("coupon_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  orderId             String   @unique @map("order_id") @db.Uuid
  discountAmountMinor BigInt   @map("discount_amount_minor")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@map("coupon_redemptions")
  @@schema("public")
}

/// Buying the bundle grants one entitlement per child, with source = BUNDLE.
model ProductBundleItem {
  bundleProductId String @map("bundle_product_id") @db.Uuid
  childProductId  String @map("child_product_id") @db.Uuid
  sortOrder       Int    @default(0) @map("sort_order")

  bundle Product @relation("BundleParent", fields: [bundleProductId], references: [id], onDelete: Cascade)
  child  Product @relation("BundleChild", fields: [childProductId], references: [id], onDelete: Restrict)

  @@id([bundleProductId, childProductId])
  @@map("product_bundle_items")
  @@schema("public")
}

/// For the multi-educator marketplace.
model PublisherProfile {
  userId                String           @id @map("user_id") @db.Uuid
  displayName           String           @map("display_name") @db.VarChar(160)
  slug                  String           @unique @db.VarChar(160)
  bio                   String?
  avatarStorageProvider StorageProvider? @map("avatar_storage_provider")
  avatarObjectKey       String?          @map("avatar_object_key")
  payoutDetails         Json             @default("{}") @map("payout_details")
  revenueSharePercent   Int              @default(0) @map("revenue_share_percent")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("publisher_profiles")
  @@schema("public")
}

/// Worth having as soon as more than one person has admin access to a system
/// that handles money.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String?  @map("entity_id") @db.VarChar(80)
  before      Json?
  after       Json?
  ip          String?  @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Live sessions (main website, jsmf.me)
//
// A session is a `products` row of type LIVE_SESSION plus one `live_sessions`
// row holding what only a session has. Being a product is what lets it be
// ordered, paid for through Razorpay, refunded and audited with no new code in
// those modules. "Is this person registered" is deliberately NOT stored here:
// it is an ACTIVE entitlement on the session product, exactly as "owns this
// PDF" is. So a refund frees the seat by itself, and there is no second
// "registered" flag that could disagree with the payment record.
//
// A bonus PDF (the revision planner) is attached with the existing
// `product_bundle_items` table — session → PDF — and granted on payment with
// source BUNDLE, which puts it in the buyer's store library.
// ---------------------------------------------------------------------------

model LiveSession {
  /// Shares the product's id: one session per product, and the product is the
  /// thing orders point at.
  productId                      String             @id @map("product_id") @db.Uuid
  /// The first day's start. A copy kept by LiveSessionService — the only writer
  /// — in the same transaction that writes the days, so listing, ordering and
  /// "registration closes when it starts" stay one indexed column.
  ///
  /// NULL when the session has no days yet: announced, open for booking, dates
  /// still to be fixed. The website shows "To be announced" for those, and
  /// registration stays open because nothing has started.
  startsAt                       DateTime?          @map("starts_at") @db.Timestamptz(6)
  /// "Live on Zoom · Link sent on mail". Display text, not a URL.
  platformLabel                  String             @map("platform_label") @db.VarChar(160)
  /// The session's stable name, used in every email and the library label,
  /// e.g. "NEET-PG Revision Bootcamp". The product's title is what the
  /// website's booking card shows and is often reworded day to day ("Day 2
  /// starts tonight!"); this one is not. NULL falls back to the title, so a
  /// session without one behaves exactly as before. Read through
  /// `sessionDisplayName()`, never directly.
  shortName                      String?            @map("short_name") @db.VarChar(120)
  /// NULL = unlimited. Seats taken are counted from entitlements, never stored,
  /// so this is the only number here that can go stale — and only by an admin
  /// changing it.
  capacity                       Int?
  /// Admin toggle: when false, both seatsRemaining and displaySeats are hidden
  /// from the public-facing API. Lets the admin suppress seat counts without
  /// deleting the underlying data.
  showSeats                      Boolean            @default(true) @map("show_seats")
  /// Keeps the session on sale after its first day has started, until its last
  /// day ends. A multi-day session is still worth joining on day 2 — usually at
  /// a lower price, which the admin sets by hand. While this is on the session
  /// stays on the website as the upcoming one and no recording is offered;
  /// once the last day ends it closes like any other.
  lateRegistration               Boolean            @default(false) @map("late_registration")
  /// Whether someone who buys a seat after a day has started still gets that
  /// day's (and earlier days') materials. True: every seat holder gets every
  /// day's materials. False: only the days that had not ended when they paid.
  lateJoinersGetEarlierMaterials Boolean            @default(true) @map("late_joiners_get_earlier_materials")
  /// TEMPORARY (external Razorpay Payment Page phase): a manually-set "seats
  /// available" number shown on /prep-kit to signal demand. NOT real capacity
  /// and not derived from entitlements. NULL = show no seats line, 0 = fully
  /// booked. Remove this column when the external checkout flow is retired.
  displaySeats                   Int?               @map("display_seats")
  /// The joining link. Private: sent only to people holding a seat, never in a
  /// public response. Nullable because it is often created days after the
  /// session is announced.
  joinUrl                        String?            @map("join_url")
  /// The Telegram group for this session's registered candidates. Private like
  /// the joining link: sent in the confirmation and the session details email,
  /// never in a public response.
  telegramUrl                    String?            @map("telegram_url")
  recordingUrl                   String?            @map("recording_url")
  /// "What you'll learn" bullets, in display order. An array rather than a
  /// child table: they are never queried, filtered or referenced, and always
  /// edited as one list.
  highlights                     String[]           @default([])
  /// "Every attendee gets Dr. Angad's high-yield revision planner (PDF) free."
  perkText                       String?            @map("perk_text") @db.VarChar(300)
  /// "Who is this session for?" — one paragraph naming the exams and the kind
  /// of preparation it suits. Null hides the section entirely rather than
  /// printing an empty heading.
  audienceText                   String?            @map("audience_text") @db.VarChar(600)
  /// Copy around the testimonials section. All three fall back to a generic
  /// default when null, so a session shows reasonable text the moment its
  /// first testimonial is added, without the admin having to fill these in.
  testimonialsHeading            String?            @map("testimonials_heading") @db.VarChar(150)
  testimonialsSubheading         String?            @map("testimonials_subheading") @db.VarChar(300)
  /// The small label on the right, e.g. "Previous FMGE session". Null hides
  /// it entirely — unlike the heading and subheading, this one has no
  /// generic fallback, because an empty tag reads as broken decoration.
  testimonialsTag                String?            @map("testimonials_tag") @db.VarChar(80)
  /// Subject line of the confirmation email sent when a seat is paid for.
  /// NULL keeps the built-in "JSMF - Your seat is confirmed: {title}". The
  /// token `{title}` is substituted with the session's title wherever it
  /// appears, so a custom subject can still carry it without being retyped
  /// every time the session is renamed.
  confirmationSubject            String?            @map("confirmation_subject") @db.VarChar(200)
  /// What the confirmation email says in place of the joining link while
  /// `joinUrl` is still empty. NULL keeps the built-in "We will email you the
  /// joining link before the session starts." Editable because that sentence
  /// is wrong whenever the dates themselves are not fixed yet — there is no
  /// "before the session starts" to point at.
  pendingJoinLinkText            String?            @map("pending_join_link_text") @db.VarChar(300)
  /// Appends a short "if this landed in Spam, mark it Not spam" info box to
  /// every email sent for this session — the confirmation, the dates
  /// announcement, each day's reminder, and the bundle-ready note. On per
  /// session rather than platform-wide: a brand-new session with no sender
  /// reputation benefits from the nudge; a steady one does not need to pester
  /// everyone forever. Defaults off, so existing sessions are unchanged.
  showNotSpamNotice              Boolean            @default(false) @map("show_not_spam_notice")
  /// When and how the items included with a seat (the bundled PDF) reach
  /// buyers. IMMEDIATE grants them at payment, named in the confirmation
  /// email. The other two hold them back until the session has ended and the
  /// item is published — AUTO_AFTER_SESSION releases them on the reminder
  /// sweep's clock, MANUAL only when an admin sends them. A deferred mode is
  /// what makes it possible to sell seats before the PDF exists.
  bundleDeliveryMode             BundleDeliveryMode @default(IMMEDIATE) @map("bundle_delivery_mode")
  createdAt                      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Restrict: a session that has been sold must keep its product forever,
  /// the same rule every other product follows (archive, never delete).
  product                  Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  days                     LiveSessionDay[]
  registrations            SessionRegistration[]
  deliveries               SessionBundleDelivery[]
  dateAnnouncements        SessionDateAnnouncement[]
  detailReceipts           SessionDetailReceipt[]
  detailEmails             SessionDetailEmail[]
  testimonials             SessionTestimonial[]
  testimonialSections      SessionTestimonialSection[]
  materials                SessionMaterial[]
  feedbackForms            FeedbackForm[]
  /// The site settings that pick this session's testimonials for the home
  /// page while no session is upcoming (at most the one singleton row).
  noSessionTestimonialsFor PlatformSettings[]

  @@index([startsAt])
  @@map("live_sessions")
  @@schema("public")
}

/// One sitting of a session. A single-day session has one row; a multi-day
/// session has one per day. One seat covers every day, and the joining link is
/// shared across them.
model LiveSessionDay {
  id              String   @id @default(uuid(7)) @db.Uuid
  liveSessionId   String   @map("live_session_id") @db.Uuid
  startsAt        DateTime @map("starts_at") @db.Timestamptz(6)
  durationMinutes Int      @map("duration_minutes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  liveSession         LiveSession                 @relation(fields: [liveSessionId], references: [productId], onDelete: Restrict)
  reminders           SessionDayReminder[]
  materials           SessionMaterial[]
  testimonialSections SessionTestimonialSection[]
  feedbackForms       FeedbackForm[]

  /// Not unique: moving a session's days by one day passes through a moment
  /// where two rows share a start. LiveSessionService refuses overlapping days,
  /// which is the stricter rule.
  @@index([liveSessionId, startsAt])
  @@index([startsAt])
  @@map("live_session_days")
  @@schema("public")
}

/// What a person told us when they signed up for a session, and what we have
/// sent them. Not the seat itself — see the comment above LiveSession.
///
/// Written when checkout starts, so a registration can exist for someone who
/// then abandons the payment. Every reader therefore joins an ACTIVE
/// entitlement to decide who is actually attending.
model SessionRegistration {
  id                 String    @id @default(uuid(7)) @db.Uuid
  liveSessionId      String    @map("live_session_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  /// Digits only, with country code (919876543210). Typed by the attendee and
  /// not verified — used for the session only, never as a login identifier.
  ///
  /// Collected on the registration form again; nullable survives from when it
  /// briefly was not. Nothing sends WhatsApp or SMS to it today — it is kept
  /// as a contact number on file, not a delivery channel.
  whatsappNumber     String?   @map("whatsapp_number") @db.VarChar(20)
  /// "NEET-PG", "INI-CET"… and "Final year", "Intern"… Free text in the
  /// database, validated against a list in the API: the options will change,
  /// and a changed option should not need a migration.
  exam               String    @db.VarChar(40)
  stage              String    @db.VarChar(40)
  /// The most recent order started for this registration, for support.
  orderId            String?   @map("order_id") @db.Uuid
  confirmationSentAt DateTime? @map("confirmation_sent_at") @db.Timestamptz(6)
  /// Reserved for attendance tracking (from the platform's report, later).
  attendedAt         DateTime? @map("attended_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  liveSession  LiveSession          @relation(fields: [liveSessionId], references: [productId], onDelete: Restrict)
  /// Restrict, like orders: a person who registered is part of a session's
  /// record, and removing an account is a deliberate process, not a cascade.
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  dayReminders SessionDayReminder[]

  @@unique([liveSessionId, userId])
  @@index([userId])
  @@map("session_registrations")
  @@schema("public")
}

/// "This person has been reminded about this day." The primary key is the
/// claim: a reminder is sent only by whoever manages to insert the row, so two
/// overlapping sweeps can never email the same person twice for the same day.
model SessionDayReminder {
  registrationId   String   @map("registration_id") @db.Uuid
  liveSessionDayId String   @map("live_session_day_id") @db.Uuid
  sentAt           DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  registration SessionRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  day          LiveSessionDay      @relation(fields: [liveSessionDayId], references: [id], onDelete: Restrict)

  @@id([registrationId, liveSessionDayId])
  @@index([liveSessionDayId])
  @@map("session_day_reminders")
  @@schema("public")
}

/// A screenshot of what someone said about a past session, shown on the
/// session's page.
///
/// Its own table rather than a `product_assets` row: that table's
/// `product_assets_current_unique` index allows one current asset per kind,
/// and testimonials are a gallery — many at once, ordered, each removable on
/// its own. Stored in the PUBLIC bucket, like a cover image, because it is
/// marketing shown to people who have not paid.
model SessionTestimonial {
  id              String          @id @default(uuid(7)) @db.Uuid
  liveSessionId   String          @map("live_session_id") @db.Uuid
  storageProvider StorageProvider @map("storage_provider")
  bucket          String          @db.VarChar(255)
  objectKey       String          @map("object_key")
  mimeType        String?         @map("mime_type") @db.VarChar(120)
  sizeBytes       BigInt?         @map("size_bytes")
  /// Display order, lowest first. Ties fall back to `createdAt`.
  sortOrder       Int             @default(0) @map("sort_order")
  uploadedById    String?         @map("uploaded_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Which gallery it belongs to. NULL is the original one — what students
  /// said about a previous session, whose copy lives on `live_sessions`
  /// (`testimonials_heading` etc.). Anything else is a named section such as
  /// "Day 1 feedback". Restrict: a section is removed with its images by
  /// the service, which also deletes the stored files.
  sectionId       String?         @map("section_id") @db.Uuid

  liveSession   LiveSession                @relation(fields: [liveSessionId], references: [productId], onDelete: Cascade)
  uploadedBy    User?                      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  section       SessionTestimonialSection? @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  noSessionPick NoSessionScreenshot?

  @@index([liveSessionId, sortOrder])
  @@index([sectionId, sortOrder])
  @@map("session_testimonials")
  @@schema("public")
}

/// A named gallery of screenshots on a session's pages, alongside the original
/// "previous session" testimonials — "What students said after Day 1", later
/// Day 2, toppers' messages, anything. Each carries its own copy and can be
/// hidden without deleting it. New kinds of section need no schema change.
///
/// `dayId` optionally ties it to one day of this session (feedback from that
/// day); SetNull so editing the dates never fails because of a gallery.
model SessionTestimonialSection {
  id            String   @id @default(uuid(7)) @db.Uuid
  liveSessionId String   @map("live_session_id") @db.Uuid
  dayId         String?  @map("day_id") @db.Uuid
  heading       String   @db.VarChar(150)
  subheading    String?  @db.VarChar(300)
  /// The small label beside the heading, e.g. "Day 1 · live". Null hides it.
  tag           String?  @db.VarChar(80)
  /// Off hides the whole section from the website; admin still sees it.
  isVisible     Boolean  @default(true) @map("is_visible")
  /// Display order among this session's sections, lowest first.
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  liveSession  LiveSession          @relation(fields: [liveSessionId], references: [productId], onDelete: Cascade)
  day          LiveSessionDay?      @relation(fields: [dayId], references: [id], onDelete: SetNull)
  testimonials SessionTestimonial[]
  highlights   FeedbackHighlight[]

  @@index([liveSessionId, sortOrder])
  @@map("session_testimonial_sections")
  @@schema("public")
}

/// How a session's included items reach its buyers. See `LiveSession`.
enum BundleDeliveryMode {
  IMMEDIATE
  AUTO_AFTER_SESSION
  MANUAL

  @@schema("public")
}

enum BundleDeliveryStatus {
  PENDING
  SENT
  FAILED

  @@schema("public")
}

/// One row per buyer of a session whose included items are delivered after the
/// session rather than at payment.
///
/// A plain claim row (as `SessionDayReminder` uses) would not be enough here:
/// an admin working through this list needs to see *why* someone has not
/// received the PDF, so the failure reason is kept rather than left in a log.
/// Nothing ever moves a row back to PENDING once it is SENT — "already sent"
/// has to survive a later "send to everyone", or a bulk click would mail the
/// same people twice.
model SessionBundleDelivery {
  id            String               @id @default(uuid(7)) @db.Uuid
  liveSessionId String               @map("live_session_id") @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  status        BundleDeliveryStatus @default(PENDING)
  /// Why the last attempt failed. Cleared when one succeeds.
  lastError     String?              @map("last_error")
  attempts      Int                  @default(0)
  sentAt        DateTime?            @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  liveSession LiveSession @relation(fields: [liveSessionId], references: [productId], onDelete: Restrict)
  /// Restrict, like every other record of what a person was sold.
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([liveSessionId, userId])
  @@index([liveSessionId, status])
  @@map("session_bundle_deliveries")
  @@schema("public")
}

enum AnnouncementStatus {
  PENDING
  SENT
  FAILED

  @@schema("public")
}

/// One row per seat holder told that a session's dates are now fixed.
/// Mirrors SessionBundleDelivery — the same admin-triggered send flow —
/// and records `announcedStartsAt` so that a later reschedule makes every
/// buyer sendable again without a separate table or a blunt re-send.
model SessionDateAnnouncement {
  id                String             @id @default(uuid(7)) @db.Uuid
  liveSessionId     String             @map("live_session_id") @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  status            AnnouncementStatus @default(PENDING)
  /// The first-day start the buyer was told about. When the session is
  /// rescheduled, rows whose announcedStartsAt differs from the current
  /// first day become eligible to be sent again.
  announcedStartsAt DateTime?          @map("announced_starts_at") @db.Timestamptz(6)
  lastError         String?            @map("last_error")
  attempts          Int                @default(0)
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  liveSession LiveSession @relation(fields: [liveSessionId], references: [productId], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([liveSessionId, userId])
  @@index([liveSessionId, status])
  @@map("session_date_announcements")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Platform-wide settings
// ---------------------------------------------------------------------------

/// A single row ("global") of site-wide toggles that are not tied to any one
/// session or product — things the admin flips on or off for the whole
/// platform at once. Modelled as a singleton row rather than a key/value
/// table because there are only a handful of these and each needs its own
/// type; add a column here for the next one rather than inventing a schema.
model PlatformSettings {
  id String @id @default("global") @db.VarChar(20)

  /// Shows a "check your spam folder" line wherever a verification email or
  /// Google sign-in is offered, across both the main website and the PDF
  /// store. Off hides it everywhere at once.
  showSpamFolderNote Boolean @default(true) @map("show_spam_folder_note")

  /// Whether store buyers may download files, or only read them in the
  /// browser reader. A product's own download_policy overrides this. On until
  /// the mobile apps ship.
  downloadsEnabled Boolean @default(true) @map("downloads_enabled")

  /// The testimonials band on the home page and /prep-kit while no session
  /// is upcoming (until now that band simply disappeared). Off hides it.
  noSessionTestimonialsEnabled    Boolean          @default(true) @map("no_session_testimonials_enabled")
  /// Whose testimonials (the session's original gallery). Null = the most
  /// recent past session that has any. SetNull: deleting that session falls
  /// back to automatic rather than failing.
  noSessionTestimonialsSessionId  String?          @map("no_session_testimonials_session_id") @db.Uuid
  /// The band's copy. Null falls back to the defaults in LiveSessionService.
  noSessionTestimonialsHeading    String?          @map("no_session_testimonials_heading") @db.VarChar(150)
  noSessionTestimonialsSubheading String?          @map("no_session_testimonials_subheading") @db.VarChar(300)
  /// On: the band shows the screenshots and replies picked one by one, from
  /// any sessions (NoSessionScreenshot, NoSessionQuote). Off: the session
  /// chosen above, or the automatic one, as before. Off by default, so the
  /// picks can be prepared before switching over.
  noSessionTestimonialsHandPicked Boolean          @default(false) @map("no_session_testimonials_hand_picked")
  /// How the written replies are laid out wherever they appear on the website:
  /// a row that scrolls sideways, or a block that wraps onto several lines.
  quotesLayout                    QuoteLayout      @default(SCROLL) @map("feedback_quotes_layout")
  /// What "Read more" on a long reply does, everywhere on the website.
  quotesExpand                    QuoteExpand      @default(POPUP) @map("feedback_quotes_expand")
  /// How Dr. Angad's portrait looks in the hero of the home page, /prep-kit
  /// and the store's home page: the arched poster with floating rank medals
  /// (POSTER), or the framed photo with a credential card below it (CARD).
  mentorCardStyle                 MentorCardStyle  @default(POSTER) @map("mentor_card_style")
  /// The portrait photo an admin uploaded for the site heroes, in the public
  /// bucket. All three null = the photo bundled with the websites. Stored as
  /// provider/bucket/key, never a URL, like every other file column.
  mentorPhotoStorageProvider      StorageProvider? @map("mentor_photo_storage_provider")
  mentorPhotoBucket               String?          @map("mentor_photo_bucket") @db.VarChar(255)
  mentorPhotoObjectKey            String?          @map("mentor_photo_object_key")

  noSessionTestimonialsSession LiveSession? @relation(fields: [noSessionTestimonialsSessionId], references: [productId], onDelete: SetNull)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// PYQ question bank & practice
// ---------------------------------------------------------------------------
//
// Owned by the `questions` module. Self-contained on purpose: nothing here
// references products or orders. Paid access is decided by PyqAccessService
// through the entitlements module's public service, so plans can change
// without a migration to these tables.
//
// Slugs are the public identifiers (`neet-pg`, `anatomy`, `anatomy--upper-limb`)
// because the PYQ web app already addresses taxonomy that way; the uuid ids
// stay internal.

enum Difficulty {
  EASY
  MEDIUM
  HARD

  @@schema("pyq")
}

enum QuestionStatus {
  /// Imported or edited but not yet visible to students.
  DRAFT
  PUBLISHED

  @@schema("pyq")
}

/// An exam a question was asked in (NEET-PG, FMGE, INI-CET).
model Exam {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(120)
  shortName   String   @map("short_name") @db.VarChar(40)
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  questions Question[]

  @@map("exams")
  @@schema("pyq")
}

/// One of the MBBS subjects.
model Subject {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  /// `pre-clinical` | `para-clinical` | `clinical`. A string rather than an
  /// enum: it is display grouping, and a new group should not need a migration.
  group       String   @db.VarChar(40)
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  topics    Topic[]
  questions Question[]

  @@map("subjects")
  @@schema("pyq")
}

/// A topic within a subject. The slug is globally unique and, by convention,
/// `${subjectSlug}--${topic}` so a topic slug alone reveals its subject.
model Topic {
  id        String   @id @default(uuid(7)) @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  slug      String   @unique @db.VarChar(160)
  name      String   @db.VarChar(160)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  questions Question[]

  @@index([subjectId])
  @@map("topics")
  @@schema("pyq")
}

/// A single-best-answer MCQ.
model Question {
  id                  String         @id @default(uuid(7)) @db.Uuid
  /// The content pipeline's own identifier. Import is an upsert on this, so
  /// re-running the same file updates rather than duplicates.
  externalKey         String         @unique @map("external_key") @db.VarChar(160)
  examId              String         @map("exam_id") @db.Uuid
  subjectId           String         @map("subject_id") @db.Uuid
  topicId             String?        @map("topic_id") @db.Uuid
  year                Int            @db.SmallInt
  stem                String
  stemImageUrl        String?        @map("stem_image_url")
  /// Placeholder figure (`{ kind, caption }`) the web app renders until real
  /// images exist. Display-only, never queried.
  stemFigure          Json?          @map("stem_figure")
  explanation         String
  explanationImageUrl String?        @map("explanation_image_url")
  explanationFigure   Json?          @map("explanation_figure")
  difficulty          Difficulty     @default(MEDIUM)
  status              QuestionStatus @default(DRAFT)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  options          QuestionOption[]
  sessionQuestions SessionQuestion[]
  attempts         Attempt[]
  bookmarks        Bookmark[]
  reports          QuestionReport[]
  collectionItems  CollectionQuestion[]
  userStates       UserQuestionState[]

  @@index([status, subjectId, topicId])
  @@index([status, examId, year])
  @@index([status, difficulty])
  @@map("questions")
  @@schema("pyq")
}

model QuestionOption {
  id         String   @id @default(uuid(7)) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  /// `A`, `B`, `C`, `D` — what the student sees beside the option.
  label      String   @db.VarChar(4)
  text       String
  imageUrl   String?  @map("image_url")
  /// Never serialised to a student before they have answered (PRACTICE) or
  /// submitted (TEST).
  isCorrect  Boolean  @default(false) @map("is_correct")
  sortOrder  Int      @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, sortOrder])
  @@map("question_options")
  @@schema("pyq")
}

enum PracticeMode {
  /// Feedback after every answer.
  PRACTICE
  /// Answers hidden until the session is submitted.
  TEST
  /// A hand-picked set (bookmarks, wrong questions) with practice feedback.
  CUSTOM

  @@schema("pyq")
}

enum PracticeSessionStatus {
  IN_PROGRESS
  SUBMITTED

  @@schema("pyq")
}

/// One sitting: a fixed, ordered set of questions chosen when it starts.
model PracticeSession {
  id               String                @id @default(uuid(7)) @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  mode             PracticeMode
  label            String                @db.VarChar(200)
  /// The filters / source the questions were drawn from, kept so history can
  /// describe the session. Never used to re-derive its questions.
  config           Json                  @default("{}")
  timeLimitSec     Int?                  @map("time_limit_sec")
  status           PracticeSessionStatus @default(IN_PROGRESS)
  startedAt        DateTime              @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt      DateTime?             @map("submitted_at") @db.Timestamptz(6)
  totalQuestions   Int                   @map("total_questions")
  /// Score fields are written once, at submit.
  correctCount     Int?                  @map("correct_count")
  incorrectCount   Int?                  @map("incorrect_count")
  unattemptedCount Int?                  @map("unattempted_count")
  /// 0-100, correct over attempted.
  accuracy         Int?
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions SessionQuestion[]
  attempts  Attempt[]

  @@index([userId, startedAt(sort: Desc)])
  @@map("practice_sessions")
  @@schema("pyq")
}

/// The ordered question list of a session, fixed when it starts.
model SessionQuestion {
  sessionId  String @map("session_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  position   Int

  session  PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([sessionId, questionId])
  @@unique([sessionId, position])
  @@index([questionId])
  @@map("session_questions")
  @@schema("pyq")
}

/// A student's interaction with one question in one session. A row may exist
/// with no selected option (flagged before answering).
model Attempt {
  id               String    @id @default(uuid(7)) @db.Uuid
  sessionId        String    @map("session_id") @db.Uuid
  questionId       String    @map("question_id") @db.Uuid
  /// Denormalised from the session so per-user stats and the daily allowance
  /// are single-index reads.
  userId           String    @map("user_id") @db.Uuid
  selectedOptionId String?   @map("selected_option_id") @db.Uuid
  isCorrect        Boolean?  @map("is_correct")
  timeSpentMs      Int       @default(0) @map("time_spent_ms")
  flagged          Boolean   @default(false)
  answeredAt       DateTime? @map("answered_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  session  PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([userId, answeredAt])
  @@index([userId, questionId, answeredAt(sort: Desc)])
  @@map("attempts")
  @@schema("pyq")
}

model Bookmark {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookmarks")
  @@schema("pyq")
}

enum QuestionReportReason {
  WRONG_ANSWER
  WRONG_EXPLANATION
  INCORRECT_QUESTION
  IMAGE_ISSUE
  OTHER

  @@schema("pyq")
}

enum QuestionReportStatus {
  OPEN
  RESOLVED
  DISMISSED

  @@schema("pyq")
}

/// A student flagging a problem with a question for content review.
model QuestionReport {
  id           String               @id @default(uuid(7)) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  questionId   String               @map("question_id") @db.Uuid
  reason       QuestionReportReason
  details      String?              @db.VarChar(2000)
  status       QuestionReportStatus @default(OPEN)
  resolvedAt   DateTime?            @map("resolved_at") @db.Timestamptz(6)
  /// What the admin did about it, written when the report is resolved or
  /// dismissed. Kept so the decision survives beyond the activity log.
  adminNote    String?              @map("admin_note") @db.VarChar(2000)
  /// Which admin closed it. Null while OPEN, and for reports closed before
  /// this column existed.
  resolvedById String?              @map("resolved_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  resolvedBy User?    @relation("QuestionReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([questionId])
  @@map("question_reports")
  @@schema("pyq")
}

/// A user-named list of questions ("High-yield pharmacology"). Distinct from a
/// bookmark: a bookmark saves one question, a collection is a themed set
/// practised and filtered as a group.
model QuestionCollection {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionQuestion[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("collections")
  @@schema("pyq")
}

/// Membership of a question in a collection, with when it was added.
model CollectionQuestion {
  collectionId String   @map("collection_id") @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  collection QuestionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  question   Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([collectionId, questionId])
  @@index([questionId])
  @@map("collection_questions")
  @@schema("pyq")
}

/// PYQ-specific preferences of one user (target exam, daily goal). One row
/// per user, created on first save; absent means defaults.
model PyqPreference {
  userId      String   @id @map("user_id") @db.Uuid
  /// Exam slug (`neet-pg`). A slug, not a foreign key, so retiring an exam
  /// never blocks or cascades into preferences.
  targetExam  String?  @map("target_exam") @db.VarChar(60)
  /// Answers per India-time day that count as "today done" for the streak.
  dailyTarget Int      @default(10) @map("daily_target") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
  @@schema("pyq")
}

/// One row per student per question they have answered or flagged: the
/// latest result and the running facts behind it. Lists, status filters,
/// statistics and revision read these indexed rows instead of re-deriving
/// everything from `attempts` on each request, which grows with a student's
/// whole history.
///
/// Derived, never edited directly: QuestionStateService rebuilds a row from
/// `attempts` whenever an attempt it depends on changes, and
/// `npm run db:pyq:rebuild-read-models` rebuilds every row (run it after
/// rolling the app back past this table and forward again). Answers inside a
/// TEST that is still in progress are left out, as everywhere else.
model UserQuestionState {
  userId         String    @map("user_id") @db.Uuid
  questionId     String    @map("question_id") @db.Uuid
  /// The most recent answer's result; null when only flagged, never answered.
  latestCorrect  Boolean?  @map("latest_correct")
  lastAnsweredAt DateTime? @map("last_answered_at") @db.Timestamptz(6)
  lastCorrectAt  DateTime? @map("last_correct_at") @db.Timestamptz(6)
  lastWrongAt    DateTime? @map("last_wrong_at") @db.Timestamptz(6)
  attemptCount   Int       @default(0) @map("attempt_count")
  incorrectCount Int       @default(0) @map("incorrect_count")
  /// Flagged in any session.
  flagged        Boolean   @default(false)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId, latestCorrect, lastAnsweredAt(sort: Desc)], map: "user_question_states_user_latest_idx")
  @@map("user_question_states")
  @@schema("pyq")
}

/// Answers given per India-time calendar day, per student — what streaks
/// read, so the topbar's streak on every page is a scan of active days rather
/// than of every attempt. Derived like UserQuestionState; unlike it, answers
/// inside a running TEST count (they keep the day alive).
model UserDailyActivity {
  userId   String   @map("user_id") @db.Uuid
  day      DateTime @db.Date
  answered Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("user_daily_activity")
  @@schema("pyq")
}

// ─── Legal documents ────────────────────────────────────────────────────────
//
// Terms, Privacy and Refund are versioned records, shared by every JSMF app:
// one document per type, whose sections are either shared or scoped to some
// apps. A published version is immutable and can never be deleted, and an
// acceptance is insert-only — both enforced by triggers in the migration, not
// only by this code. See docs/legal/README.md.

enum LegalDocumentType {
  TERMS
  PRIVACY
  REFUND

  @@schema("public")
}

enum LegalVersionStatus {
  DRAFT
  PUBLISHED

  @@schema("public")
}

/// MAJOR bumps 1.x → 2.0 and asks users to accept again (when acceptance is
/// enforced); MINOR bumps 1.0 → 1.1 and is a notice only.
enum LegalChangeKind {
  MAJOR
  MINOR

  @@schema("public")
}

enum LegalAcceptanceKind {
  /// Agreement to a contract (Terms).
  ACCEPTED
  /// Confirmation of having been shown a policy (Privacy, Refund) — not consent.
  ACKNOWLEDGED

  @@schema("public")
}

enum LegalAcceptanceContext {
  SIGNUP
  RE_ACCEPT
  CHECKOUT

  @@schema("public")
}

/// Which JSMF app something was shown on or accepted from.
enum JsmfApp {
  MAIN
  PYQ
  STORE

  @@schema("public")
}

model LegalDocumentVersion {
  id               String             @id @default(uuid(7)) @db.Uuid
  type             LegalDocumentType
  /// "1.0", "1.1", "2.0" — assigned by the server at publish. Null while a draft.
  version          String?            @db.VarChar(16)
  status           LegalVersionStatus @default(DRAFT)
  title            String             @db.VarChar(200)
  /// Ordered `{ id, heading, body, apps }` objects; `apps` empty = every app.
  /// The body is plain text: paragraphs, "- " bullets and [text](url) links.
  sections         Json
  /// sha256 of title + sections, fixed at publish — proof the text is unchanged.
  contentHash      String?            @map("content_hash") @db.Char(64)
  changeKind       LegalChangeKind?   @map("change_kind")
  /// What changed, in the admin's words. Shown in history and to users.
  changeSummary    String?            @map("change_summary") @db.VarChar(2000)
  /// When this version takes over. Defaults to the publish time.
  effectiveAt      DateTime?          @map("effective_at") @db.Timestamptz(6)
  /// The version a draft was started from — the trail of a rollback.
  basedOnVersionId String?            @map("based_on_version_id") @db.Uuid
  createdById      String?            @map("created_by_id") @db.Uuid
  publishedById    String?            @map("published_by_id") @db.Uuid
  publishedAt      DateTime?          @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  basedOn     LegalDocumentVersion?  @relation("LegalVersionBasedOn", fields: [basedOnVersionId], references: [id], onDelete: Restrict)
  derived     LegalDocumentVersion[] @relation("LegalVersionBasedOn")
  createdBy   User?                  @relation("LegalVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy User?                  @relation("LegalVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  acceptances LegalAcceptance[]

  @@unique([type, version])
  @@index([type, status, effectiveAt])
  @@map("legal_document_versions")
  @@schema("public")
}

/// One user's agreement to (or acknowledgement of) one exact version.
/// Insert-only: accepting a newer version adds a row and never erases this one.
model LegalAcceptance {
  id         String                 @id @default(uuid(7)) @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  versionId  String                 @map("version_id") @db.Uuid
  kind       LegalAcceptanceKind
  context    LegalAcceptanceContext
  app        JsmfApp
  /// The order a checkout acknowledgement was given for.
  orderId    String?                @map("order_id") @db.Uuid
  /// Server clock, UTC. Never taken from the client.
  acceptedAt DateTime               @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ipAddress  String?                @map("ip_address") @db.VarChar(45)
  userAgent  String?                @map("user_agent") @db.VarChar(512)

  user    User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  version LegalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([userId, versionId])
  @@index([versionId, acceptedAt])
  @@map("legal_acceptances")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// First-party activity analytics
// ---------------------------------------------------------------------------

/// One thing a visitor did on a JSMF website — a page view, a click on "Book",
/// the payment window opening. Written in batches by POST /analytics/events and
/// read only in aggregate by the admin Analytics page. See docs/analytics.
///
/// Deliberately anonymous: no IP address and no user agent are stored, only a
/// coarse device class derived from the user agent at write time. `visitorId`
/// is a random id the browser generated for itself, not a fingerprint.
///
/// Never authoritative for money or accounts — orders, payments and users are.
/// The admin page shows both side by side for that reason.
model AnalyticsEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Which website sent it. MAIN only today; STORE and PYQ share the table.
  app         JsmfApp
  /// From a server-side allowlist; anything else is dropped before insert.
  name        String   @db.VarChar(64)
  /// Random, generated in the browser and kept in localStorage.
  visitorId   String   @map("visitor_id") @db.Uuid
  /// Per tab, rotated after 30 minutes idle.
  sessionId   String   @map("session_id") @db.VarChar(64)
  /// Set only when the request carried a valid access token. SetNull: deleting
  /// an account leaves its anonymous activity counted but no longer linked.
  userId      String?  @map("user_id") @db.Uuid
  /// Pathname only — the query string is stripped by the client and again here.
  path        String   @db.VarChar(512)
  /// External referrer as host + path, query stripped. Null for direct visits
  /// and for navigation within the site.
  referrer    String?  @db.VarChar(512)
  utmSource   String?  @map("utm_source") @db.VarChar(128)
  utmMedium   String?  @map("utm_medium") @db.VarChar(128)
  utmCampaign String?  @map("utm_campaign") @db.VarChar(128)
  /// Small flat object of strings / numbers / booleans, at most ~2 KB.
  props       Json?
  /// mobile | tablet | desktop, from the user agent on the server.
  deviceType  String   @map("device_type") @db.VarChar(16)
  /// Server clock. The client's own timestamp is never trusted.
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([app, occurredAt])
  @@index([app, name, occurredAt])
  @@index([visitorId])
  @@map("analytics_events")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// One-to-one mentorship
// ---------------------------------------------------------------------------

/// Where a booking is in its life. Only PENDING_PAYMENT and CONFIRMED occupy
/// time: the exclusion constraint in the migration covers exactly those two.
enum MentorshipBookingStatus {
  /// The slot is held while the buyer pays, until `hold_expires_at`.
  PENDING_PAYMENT
  CONFIRMED
  /// Paid, but the payment arrived after the hold lapsed and someone else had
  /// taken the time. Holds no slot; an admin reschedules it or refunds it.
  PAID_UNSCHEDULED
  /// The hold lapsed without a payment.
  EXPIRED
  /// Refunded, or cancelled by an admin.
  CANCELLED
  COMPLETED
  NO_SHOW

  @@schema("public")
}

enum MentorshipExceptionKind {
  /// No calls on this date: the whole day, or just the given window.
  BLOCK
  /// An extra window on this date, on top of the weekly hours.
  EXTRA

  @@schema("public")
}

/// A one-to-one call as a product: price, title and status live on the
/// product (one id, like live sessions); everything only a bookable call has
/// lives here. All times in the rules are local to `timezone`.
model MentorshipOffering {
  productId               String   @id @map("product_id") @db.Uuid
  durationMinutes         Int      @default(45) @map("duration_minutes")
  /// Kept free after each call. Slots start every duration + buffer minutes.
  bufferMinutes           Int      @default(15) @map("buffer_minutes")
  /// IANA name. The weekly hours and dated exceptions are read in this zone.
  timezone                String   @default("Asia/Kolkata") @db.VarChar(64)
  /// The earliest bookable slot is at least this far away.
  minNoticeMinutes        Int      @default(720) @map("min_notice_minutes")
  /// How many days ahead slots are offered.
  bookingWindowDays       Int      @default(21) @map("booking_window_days")
  /// The buyer may move their own booking until this long before it starts.
  rescheduleCutoffMinutes Int      @default(1440) @map("reschedule_cutoff_minutes")
  /// Self-service moves allowed per booking. An admin can always move it.
  maxReschedules          Int      @default(2) @map("max_reschedules")
  /// "Google Meet". Display text, not a URL.
  platformLabel           String   @default("Google Meet") @map("platform_label") @db.VarChar(160)
  /// "What you get" bullets, in display order.
  highlights              String[] @default([])
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Restrict: a product that has been sold keeps its offering forever.
  product    Product                           @relation(fields: [productId], references: [id], onDelete: Restrict)
  rules      MentorshipAvailabilityRule[]
  exceptions MentorshipAvailabilityException[]
  bookings   MentorshipBooking[]

  @@map("mentorship_offerings")
  @@schema("public")
}

/// Recurring weekly hours: on `weekday` (1 = Monday ... 7 = Sunday), calls may
/// be held between `start_minute` and `end_minute` after local midnight.
model MentorshipAvailabilityRule {
  id          String   @id @default(uuid(7)) @db.Uuid
  offeringId  String   @map("offering_id") @db.Uuid
  weekday     Int
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Cascade: rules are configuration of the offering, not a record of anything.
  offering MentorshipOffering @relation(fields: [offeringId], references: [productId], onDelete: Cascade)

  @@index([offeringId, weekday])
  @@map("mentorship_availability_rules")
  @@schema("public")
}

/// A change to the weekly hours on one local date: a block (the whole day
/// when the minutes are null) or an extra window.
model MentorshipAvailabilityException {
  id          String                  @id @default(uuid(7)) @db.Uuid
  offeringId  String                  @map("offering_id") @db.Uuid
  date        DateTime                @db.Date
  kind        MentorshipExceptionKind
  startMinute Int?                    @map("start_minute")
  endMinute   Int?                    @map("end_minute")
  note        String?                 @db.VarChar(160)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  offering MentorshipOffering @relation(fields: [offeringId], references: [productId], onDelete: Cascade)

  @@index([offeringId, date])
  @@map("mentorship_availability_exceptions")
  @@schema("public")
}

/// One booked call. Two active bookings of an offering can never overlap: the
/// migration adds an exclusion constraint over [starts_at, blocked_until) for
/// PENDING_PAYMENT and CONFIRMED rows, so the database itself refuses a
/// double booking however two requests race.
model MentorshipBooking {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  offeringId         String                  @map("offering_id") @db.Uuid
  userId             String                  @map("user_id") @db.Uuid
  /// The order paying for this call. Set in the request that holds the slot.
  orderId            String?                 @unique @map("order_id") @db.Uuid
  status             MentorshipBookingStatus @default(PENDING_PAYMENT)
  startsAt           DateTime                @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime                @map("ends_at") @db.Timestamptz(6)
  /// endsAt + the offering's buffer at booking time: the range actually kept
  /// free, and what the exclusion constraint compares.
  blockedUntil       DateTime                @map("blocked_until") @db.Timestamptz(6)
  holdExpiresAt      DateTime?               @map("hold_expires_at") @db.Timestamptz(6)
  /// As the attendee typed it: the account name is not always the attendee.
  attendeeName       String                  @map("attendee_name") @db.VarChar(120)
  /// E.164 digits without the +. A contact number on file, not verified.
  whatsappNumber     String?                 @map("whatsapp_number") @db.VarChar(20)
  exam               String                  @db.VarChar(40)
  /// "What would you like to discuss?", optional.
  notes              String?                 @db.VarChar(1000)
  /// Private: in the attendee's own responses and emails, never a public one.
  meetUrl            String?                 @map("meet_url")
  rescheduleCount    Int                     @default(0) @map("reschedule_count")
  confirmedAt        DateTime?               @map("confirmed_at") @db.Timestamptz(6)
  /// When the email naming this booking's current time last went out.
  confirmationSentAt DateTime?               @map("confirmation_sent_at") @db.Timestamptz(6)
  /// When the attendee was last emailed the joining link.
  meetLinkSentAt     DateTime?               @map("meet_link_sent_at") @db.Timestamptz(6)
  /// Set when the pre-call reminder is claimed; cleared by a reschedule.
  reminderSentAt     DateTime?               @map("reminder_sent_at") @db.Timestamptz(6)
  cancelledAt        DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  cancelReason       String?                 @map("cancel_reason") @db.VarChar(300)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  offering MentorshipOffering @relation(fields: [offeringId], references: [productId], onDelete: Restrict)
  /// Restrict, like orders: a booking is part of the business record.
  user     User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  order    Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([offeringId, startsAt])
  @@index([userId, startsAt(sort: Desc)])
  @@index([status, startsAt])
  @@map("mentorship_bookings")
  @@schema("public")
}

// --- offline sales -----------------------------------------------------------

/// How the money for an offline sale arrived.
enum OfflinePaymentMethod {
  /// Razorpay's hosted Payment Page — a real Razorpay payment, refundable there.
  RAZORPAY_PAYMENT_PAGE
  UPI_DIRECT
  BANK_TRANSFER
  CASH
  OTHER

  @@schema("public")
}

/// How an admin put the sale into the system.
enum OfflineSaleEntry {
  FORM
  FILE
  /// prisma/backfill-session-buyers.ts, from a terminal.
  SCRIPT

  @@schema("public")
}

/// A purchase whose money arrived outside checkout, recorded by an admin.
///
/// The order, its payment and the entitlement are ordinary rows — every
/// reminder, seat count and refund path treats this buyer like any other. This
/// row only says where the money came from and who recorded it, which is what
/// makes "the buyers we added by hand" a list rather than a guess.
model OfflineSale {
  id           String               @id @default(uuid(7)) @db.Uuid
  /// One order per sale; the order holds the amounts (subtotal, discount, total).
  orderId      String               @unique @map("order_id") @db.Uuid
  productId    String               @map("product_id") @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  method       OfflinePaymentMethod
  /// What identifies the payment where it happened: a Razorpay `pay_…` id, a
  /// UPI transaction reference (UTR), a cheque number.
  reference    String?              @db.VarChar(100)
  note         String?              @db.VarChar(500)
  paidAt       DateTime             @map("paid_at") @db.Timestamptz(6)
  entry        OfflineSaleEntry
  /// Null for sales recorded by the script, which has no signed-in admin.
  recordedById String?              @map("recorded_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  order      Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user       User    @relation("OfflineSaleBuyer", fields: [userId], references: [id], onDelete: Restrict)
  recordedBy User?   @relation("OfflineSaleRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([productId, paidAt])
  @@map("offline_sales")
  @@schema("public")
}

// --- session details: what each attendee was actually sent ------------------

/// Which email carried a detail to an attendee.
enum SessionDetailSource {
  /// The confirmation straight after payment.
  CONFIRMATION
  /// The session details email an admin sends.
  DETAILS_EMAIL
  /// The automatic reminder before a day (it carries the joining link).
  REMINDER

  @@schema("public")
}

enum SessionDetailEmailStatus {
  SENT
  FAILED

  @@schema("public")
}

/// What one seat holder was last actually sent, one row per detail.
///
/// The admin's table compares this with the session as it is now: no row is
/// "not sent", a different value is "changed since sent", the same value is
/// "up to date". Storing the value itself rather than a version number is what
/// makes going back to an earlier link work — whoever last received that exact
/// link is up to date again.
model SessionDetailReceipt {
  liveSessionId String              @map("live_session_id") @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  /// "dates", "join_link", "telegram" (events/domain/session-details.ts). Text,
  /// not an enum, so a new kind of detail needs no migration.
  item          String              @db.VarChar(40)
  /// Exactly what they received: the link, or the schedule's fingerprint.
  value         String
  source        SessionDetailSource
  receivedAt    DateTime            @map("received_at") @db.Timestamptz(6)

  liveSession LiveSession @relation(fields: [liveSessionId], references: [productId], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([liveSessionId, userId, item])
  @@map("session_detail_receipts")
  @@schema("public")
}

/// Every session details email an admin sent, with exactly what it carried —
/// the history behind the receipts, and where a failure's reason is kept.
model SessionDetailEmail {
  id            String                   @id @default(uuid(7)) @db.Uuid
  liveSessionId String                   @map("live_session_id") @db.Uuid
  userId        String                   @map("user_id") @db.Uuid
  /// The details this email carried, item → value: { "join_link": "https://…" }.
  items         Json
  status        SessionDetailEmailStatus
  error         String?
  /// The admin who sent it.
  sentById      String?                  @map("sent_by_id") @db.Uuid
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  liveSession LiveSession @relation(fields: [liveSessionId], references: [productId], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([liveSessionId, userId, createdAt(sort: Desc)])
  @@map("session_detail_emails")
  @@schema("public")
}

/// A PDF from the store, attached to one day of a live session. Seat holders
/// get it as an entitlement (source SESSION_MATERIAL), so it appears in their
/// library and downloads through the ordinary path. Who gets it is decided by
/// the session's `lateJoinersGetEarlierMaterials` and when each person paid.
///
/// Restrict on the day: a day with materials cannot be deleted by editing the
/// session's dates — the admin removes the materials first, which also takes
/// the access back, rather than losing it silently.
model SessionMaterial {
  id            String   @id @default(uuid(7)) @db.Uuid
  liveSessionId String   @map("live_session_id") @db.Uuid
  dayId         String   @map("day_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  addedById     String?  @map("added_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  liveSession LiveSession             @relation(fields: [liveSessionId], references: [productId], onDelete: Restrict)
  day         LiveSessionDay          @relation(fields: [dayId], references: [id], onDelete: Restrict)
  product     Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  addedBy     User?                   @relation("SessionMaterialAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  notices     SessionMaterialNotice[]

  @@unique([dayId, productId])
  @@index([liveSessionId])
  @@index([productId])
  @@map("session_materials")
  @@schema("public")
}

/// Whether one seat holder has been emailed about one material. Exists so the
/// admin can see per person who has been told and send to the rest; access
/// itself never depends on it. A failure keeps the row with `sentAt` null and
/// the reason, so it is retried by the next send.
model SessionMaterialNotice {
  materialId String    @map("material_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  sentAt     DateTime? @map("sent_at") @db.Timestamptz(6)
  lastError  String?   @map("last_error") @db.VarChar(500)
  attempts   Int       @default(0)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  material SessionMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([materialId, userId])
  @@map("session_material_notices")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Feedback: forms seat holders fill in after a session day, on jsmf.me
// ---------------------------------------------------------------------------
//
// Replaces the Google Form. Owned by the feedback module, which reads the live
// session tables (who holds a seat, when a day ends). Nothing in the events
// module reads these tables; the website gets highlights through the
// SessionShowcase registry.
//
//   form ─┬─ questions          what is asked, in order
//         ├─ invites            per seat holder: emailed? opened? (the tracking)
//         └─ responses ── answers     one row per question, typed columns
//                     └── highlights  a reply picked to show on the website

enum FeedbackFormStatus {
  /// Being written. Not reachable; nothing is emailed.
  DRAFT
  /// Taking replies; emails go out as `emailMode` says.
  OPEN
  /// No new replies or edits. Results stay.
  CLOSED

  @@schema("public")
}

enum FeedbackEmailMode {
  /// The 5-minute sweep emails every eligible seat holder once the form's day
  /// has ended (plus `emailDelayMinutes`) while the form is open.
  AUTO_AFTER_DAY
  /// Nothing goes out until an admin sends it.
  MANUAL

  @@schema("public")
}

enum FeedbackQuestionKind {
  /// 1 to 5 stars.
  RATING
  /// 0 to 10, "how likely are you to recommend".
  SCALE
  SHORT_TEXT
  LONG_TEXT
  /// Exactly one of `options`.
  SINGLE_CHOICE
  /// Any of `options`.
  MULTI_CHOICE

  @@schema("public")
}

enum FeedbackResponseSource {
  /// The personal link in the email: no sign-in.
  EMAIL_LINK
  /// The shared (Telegram) link, signed in with Google.
  SIGNED_IN
  /// The shared link with the form's `openLink` on: no sign-in, a typed name,
  /// no account. Not verified — anyone holding the link can send one.
  OPEN_LINK

  @@schema("public")
}

/// One feedback form, usually for one day of a session ("Day 1 feedback").
/// `dayId` null means the session as a whole, sent after its last day.
model FeedbackForm {
  id                  String             @id @default(uuid(7)) @db.Uuid
  liveSessionId       String             @map("live_session_id") @db.Uuid
  /// Restrict: a day with a feedback form cannot be removed by editing the
  /// session's dates, because its replies are about that day.
  dayId               String?            @map("day_id") @db.Uuid
  title               String             @db.VarChar(150)
  /// Shown above the questions. Plain text; line breaks are kept.
  intro               String?            @db.VarChar(1000)
  /// Shown after a reply is saved. Null uses a built-in thank-you.
  thankYouText        String?            @map("thank_you_text") @db.VarChar(500)
  status              FeedbackFormStatus @default(DRAFT)
  emailMode           FeedbackEmailMode  @default(AUTO_AFTER_DAY) @map("email_mode")
  /// How long after the day ends the automatic email goes out. 0 = at the end.
  emailDelayMinutes   Int                @default(0) @map("email_delay_minutes")
  /// Offers the student a "hide my name from the team" choice. The reply is
  /// still tied to their account (one reply per person, and they can edit it),
  /// but no admin screen or export shows who wrote it.
  allowAnonymous      Boolean            @default(false) @map("allow_anonymous")
  /// Asks the student "Can we show this on our website?". Off (the default):
  /// the team decides which replies to show, and any reply can be picked. On:
  /// only replies that said yes can be.
  askConsentToPublish Boolean            @default(false) @map("ask_consent_to_publish")
  /// Asks the student whether they would like their first name shown if
  /// their reply appears on the website. Off (default): not asked. Either
  /// way the admin decides when picking a reply; the answer is shown to them
  /// as guidance only.
  askShowName         Boolean            @default(false) @map("ask_show_name")
  /// The shared (Telegram) link takes replies without signing in: the person
  /// types their name, and the reply has no account. The emailed personal
  /// links and signed-in seat holders work exactly as before. Such replies
  /// cannot be checked against seats or limited to one per person, so they
  /// are marked "not verified" to the team.
  openLink            Boolean            @default(false) @map("open_link")
  /// After this the form takes no new replies, as if CLOSED. Null = open until closed by hand.
  closesAt            DateTime?          @map("closes_at") @db.Timestamptz(6)
  createdById         String?            @map("created_by_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  liveSession LiveSession        @relation(fields: [liveSessionId], references: [productId], onDelete: Restrict)
  day         LiveSessionDay?    @relation(fields: [dayId], references: [id], onDelete: Restrict)
  createdBy   User?              @relation("FeedbackFormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  questions   FeedbackQuestion[]
  invites     FeedbackInvite[]
  responses   FeedbackResponse[]

  @@index([liveSessionId, createdAt])
  @@index([status])
  @@map("feedback_forms")
  @@schema("public")
}

/// One question on a form. A question with answers is never deleted: removing
/// it from the form archives it, so past replies keep their meaning. For the
/// same reason its `kind` cannot change once it has been answered.
model FeedbackQuestion {
  id         String               @id @default(uuid(7)) @db.Uuid
  formId     String               @map("form_id") @db.Uuid
  kind       FeedbackQuestionKind
  label      String               @db.VarChar(300)
  helpText   String?              @map("help_text") @db.VarChar(500)
  required   Boolean              @default(false)
  /// The choices for SINGLE_CHOICE and MULTI_CHOICE; empty otherwise. Answers
  /// store the chosen text itself, so renaming a choice later leaves earlier
  /// answers as they were given.
  options    String[]             @default([])
  sortOrder  Int                  @default(0) @map("sort_order")
  /// Set when it is removed from a form that already had answers to it.
  archivedAt DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Cascade, but only reachable for a form with no replies: the service
  /// refuses to delete any other.
  form    FeedbackForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers FeedbackAnswer[]

  @@index([formId, sortOrder])
  @@map("feedback_questions")
  @@schema("public")
}

/// Per seat holder and form: whether they have been emailed their personal
/// link, and whether they opened it. This is the table behind "who has been
/// asked, who replied". The personal link carries this row's `id`, signed
/// (see feedback/domain/feedback-link.ts), so no secret is stored here.
model FeedbackInvite {
  id            String    @id @default(uuid(7)) @db.Uuid
  formId        String    @map("form_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// The last successful email. Null = never emailed.
  emailedAt     DateTime? @map("emailed_at") @db.Timestamptz(6)
  /// Successful emails: 1 is the invitation, anything more is reminders.
  emailCount    Int       @default(0) @map("email_count")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.VarChar(500)
  /// Set while a send is emailing this person, cleared when it finishes, so
  /// two overlapping sends (a sweep and an admin click, or two instances)
  /// cannot both email them. A claim older than a few minutes is treated as
  /// abandoned: the process died mid-send.
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(6)
  firstOpenedAt DateTime? @map("first_opened_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  form FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([formId, userId])
  @@map("feedback_invites")
  @@schema("public")
}

/// One person's reply to one form, one per person: filling the form in again
/// edits this row rather than adding a second.
model FeedbackResponse {
  id               String                 @id @default(uuid(7)) @db.Uuid
  formId           String                 @map("form_id") @db.Uuid
  /// Null only for an OPEN_LINK reply, which has no account.
  userId           String?                @map("user_id") @db.Uuid
  source           FeedbackResponseSource
  /// The name typed on the open link. Null for every other reply, whose name
  /// comes from the account.
  respondentName   String?                @map("respondent_name") @db.VarChar(80)
  /// SHA-256 of a random key kept in the browser that sent an OPEN_LINK reply,
  /// so that browser can change its reply instead of sending a second one.
  editKeyHash      String?                @map("edit_key_hash") @db.Char(64)
  /// The student asked for their name to be hidden from the team.
  isAnonymous      Boolean                @default(false) @map("is_anonymous")
  /// "Yes, you can show this on your website." Only asked when the form's
  /// `askConsentToPublish` is on; otherwise stays false and is not consulted.
  consentToPublish Boolean                @default(false) @map("consent_to_publish")
  /// The student's answer to "show my first name with it?". Null when the
  /// form did not ask. Guidance for the admin, who decides.
  showName         Boolean?               @map("show_name")
  submittedAt      DateTime               @default(now()) @map("submitted_at") @db.Timestamptz(6)
  /// The last time the student changed it. Null = never edited.
  editedAt         DateTime?              @map("edited_at") @db.Timestamptz(6)

  /// Restrict: a form with replies is closed, never deleted.
  form           FeedbackForm        @relation(fields: [formId], references: [id], onDelete: Restrict)
  user           User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers        FeedbackAnswer[]
  highlights     FeedbackHighlight[]
  noSessionQuote NoSessionQuote?

  @@unique([formId, userId])
  @@unique([formId, editKeyHash])
  @@index([formId, submittedAt])
  @@map("feedback_responses")
  @@schema("public")
}

/// One answer. Typed columns rather than a JSON blob, so averages and counts
/// are plain SQL: `ratingValue` for RATING and SCALE, `textValue` for the text
/// kinds, `choiceValues` for the choice kinds. CHECK constraints keep values
/// in range (see this table's migration).
model FeedbackAnswer {
  responseId   String   @map("response_id") @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  ratingValue  Int?     @map("rating_value") @db.SmallInt
  textValue    String?  @map("text_value")
  choiceValues String[] @default([]) @map("choice_values")

  response FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question FeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([responseId, questionId])
  @@index([questionId])
  @@map("feedback_answers")
  @@schema("public")
}

/// A reply an admin picked to show on the website, inside one of the session's
/// feedback sections ("What students said after Day 1") next to the
/// screenshots. Only possible when the student consented. `quote` and
/// `attribution` are copies the admin can tidy (a typo, a long reply cut down)
/// without changing what the student actually wrote.
model FeedbackHighlight {
  id          String   @id @default(uuid(7)) @db.Uuid
  responseId  String   @map("response_id") @db.Uuid
  sectionId   String   @map("section_id") @db.Uuid
  quote       String   @db.VarChar(5000)
  /// "Riya · Final year". "A JSMF student" for an anonymous reply.
  attribution String   @db.VarChar(120)
  /// Stars shown on the card, 1 to 5. Null shows none.
  rating      Int?     @db.SmallInt
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Cascade both ways: a highlight is only a display pointer. Deleting the
  /// reply or the section takes it off the page.
  response  FeedbackResponse          @relation(fields: [responseId], references: [id], onDelete: Cascade)
  section   SessionTestimonialSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy User?                     @relation("FeedbackHighlightCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([responseId, sectionId])
  @@index([sectionId, sortOrder])
  @@map("feedback_highlights")
  @@schema("public")
}

/// How the quote cards are laid out on the website. SCROLL is one row that
/// scrolls sideways, two or three in view at a time; GRID wraps them onto as
/// many lines as it takes, two or three across, with nothing to scroll.
/// What "Read more" on a long reply does. POPUP opens the whole reply over
/// the page, so the cards keep their size; INLINE grows that card in place.
enum QuoteExpand {
  POPUP
  INLINE

  @@schema("public")
}

/// The two looks for the mentor portrait in the site heroes.
enum MentorCardStyle {
  POSTER
  CARD

  @@schema("public")
}

enum QuoteLayout {
  SCROLL
  GRID

  @@schema("public")
}

/// A screenshot picked for the home page's testimonials band while no session
/// is upcoming (PlatformSettings.noSessionTestimonialsHandPicked). Only a
/// pointer: the image stays the session's. Cascade: deleting the screenshot
/// takes it off the band.
model NoSessionScreenshot {
  testimonialId String   @id @map("testimonial_id") @db.Uuid
  /// Display order, lowest first.
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  testimonial SessionTestimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
  @@map("no_session_screenshots")
  @@schema("public")
}

/// A feedback reply picked for the same band, as a quote card. Like
/// FeedbackHighlight: `quote` and `attribution` are copies the admin can tidy,
/// and the same consent and anonymity rules apply. One per reply.
model NoSessionQuote {
  id          String   @id @default(uuid(7)) @db.Uuid
  responseId  String   @unique @map("response_id") @db.Uuid
  quote       String   @db.VarChar(5000)
  /// "Riya · Final year". "A JSMF student" for an anonymous reply.
  attribution String   @db.VarChar(120)
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  response  FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("NoSessionQuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sortOrder])
  @@map("no_session_quotes")
  @@schema("public")
}
