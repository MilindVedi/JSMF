# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call this API.
# 3000 = the PYQ web app (web/), 3001 = the PDF platform (pdf-web/), 3002 = the
# main website (main-web/). They are
# separate Next.js projects, so both need to be listed.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# This API's own public base URL (including /api). Signed download links point
# back here, so in production this must be the real external URL.
APP_PUBLIC_URL=http://localhost:4000/api

# --- Database -----------------------------------------------------------
# Matches docker-compose.yml. `npm run db:up` starts it.
DATABASE_URL=postgresql://jsmf:jsmf@localhost:5433/jsmf?schema=public

# --- Auth (RS256) -------------------------------------------------------
# Access tokens are signed with an RSA private key held ONLY by this service;
# anything else verifies them with the public key (also published at
# GET /api/auth/jwks). That is what lets other JSMF apps — and a future
# standalone auth service — verify tokens without holding the signing key.
#
# Generate a keypair:
#   node -e "const c=require('crypto');const{privateKey:a,publicKey:b}=c.generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log('JWT_PRIVATE_KEY_BASE64='+Buffer.from(a).toString('base64'));console.log('JWT_PUBLIC_KEY_BASE64='+Buffer.from(b).toString('base64'))"
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
# Identifies which key signed a token, so keys can be rotated later without
# invalidating everything in flight.
JWT_KEY_ID=jsmf-identity-1
JWT_ISSUER=jsmf-identity
JWT_AUDIENCE=jsmf
JWT_ACCESS_TTL=15m
# Refresh tokens are opaque random strings (not JWTs) — the database is already
# the source of truth for rotation and revocation.
REFRESH_TOKEN_TTL_DAYS=30

# --- Storage ------------------------------------------------------------
# STORAGE_DRIVER: local | cloudinary | gcs
# STORAGE_DRIVER=local writes to .storage/ on disk and serves time-limited
# signed URLs from this API itself — so the whole download/entitlement flow
# works identically before any cloud account exists. Switch to `cloudinary`
# and fill the block below to go live; no application code changes.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage
# Largest single file an admin may upload, in megabytes. 10 matches Cloudinary's
# actual free-plan ceiling on raw uploads (confirmed empirically) — raise this
# only after raising the Cloudinary plan or moving primary-file storage
# elsewhere, or a large file will pass this check and still fail at Cloudinary.
MAX_UPLOAD_SIZE_MB=10
# Secret used to sign local-driver download URLs. Any random string.
STORAGE_SIGNING_SECRET=change-me-dev-only-storage-signing-secret
# How long a download link stays valid.
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Where files are grouped. Folder prefixes on Cloudinary; bucket names if a
# bucket-based provider (GCS/S3) is added later.
STORAGE_PRIVATE_BUCKET=jsmf/private
STORAGE_PUBLIC_BUCKET=jsmf/public

# Cloudinary (only needed when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Cloud Storage (STORAGE_DRIVER=gcs) ---------------------------
# Real bucket names, and deliberately separate from STORAGE_*_BUCKET above:
# those are Cloudinary folder prefixes that existing objects already record in
# their `bucket` column, so repointing them would change how already-uploaded
# Cloudinary files are addressed.
#
# Two buckets, not one with prefixes. With uniform bucket-level access (which
# you should enable), visibility is a property of the bucket — so the private
# bucket is the one with no public access to grant, and a mistake in the
# adapter cannot publish a purchased PDF.
#
#   gcloud storage buckets create gs://<private> --location=<region> #     --uniform-bucket-level-access --public-access-prevention
#   gcloud storage buckets create gs://<public> --location=<region> #     --uniform-bucket-level-access
#   gcloud storage buckets add-iam-policy-binding gs://<public> #     --member=allUsers --role=roles/storage.objectViewer
#
# Credentials come from Application Default Credentials — the attached service
# account on Cloud Run, or `gcloud auth application-default login` locally.
# There is deliberately no key-file setting: a JSON key is a long-lived
# credential that has to be stored somewhere, and on Cloud Run it buys nothing.
#
# The service account needs roles/storage.objectAdmin on both buckets, and
# roles/iam.serviceAccountTokenCreator ON ITSELF — signed URLs are generated
# through the IAM signBlob API when there is no private key, and that grant is
# easy to miss because everything else works without it.
#
# Use SEPARATE buckets per environment. Local development writing into the
# buckets customers are served from is the kind of mistake that is obvious in
# hindsight and invisible beforehand — a dev upload becomes a live product's
# file, and a dev delete removes one.
#
#   local / dev : jsmf-dev-private-509708 / jsmf-dev-public-509708
#   Cloud Run   : jsmf-private-509708     / jsmf-public-509708
#
# Locally this also needs credentials. Use the scoped dev service account
# rather than your own account — it holds Storage Object Admin on the two dev
# buckets and has no other permission anywhere in the project, so a local
# mishap cannot reach production storage, Secret Manager or Cloud Run:
#
#   gcloud auth application-default login #     --impersonate-service-account=jsmf-local-dev@production-509708.iam.gserviceaccount.com
#
# then set GCLOUD_CONFIG_DIR in the repo-root .env so docker-compose can mount
# the credentials into the container.
#
# Omitting --impersonate-service-account mounts your personal credentials
# instead, which are Owner on this project — that is the thing to avoid.
GCS_PRIVATE_BUCKET=
GCS_PUBLIC_BUCKET=
# Optional; inferred from ADC when unset, which is normal on Cloud Run.
GCS_PROJECT_ID=

# --- Redis (off in V1, deliberately) -------------------------------------
# V1 runs without Redis to keep hosting costs down. Nothing in V1 needs it:
# rate-limit counters live in the API process's memory, and there are no
# caches or background job queues yet.
#
# Turn it on (REDIS_ENABLED=true + REDIS_URL) when any of these is true:
#   1. More than one API instance runs — in-memory rate limiting is per
#      process, so N instances silently allow N times the intended limit.
#   2. The first background job is added (exports, bulk ingest, email).
#   3. A read path gets hot enough that Postgres alone is not enough.
#
# Enabling it is this flag and a URL; no application code changes.
# `npm run db:up` starts a local Redis on 6380 for when you do.
REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6380

# Rate limiting, per minute. The window is always one minute; only the counts
# are configurable.
#
# RATE_LIMIT_PER_MINUTE is what a single caller gets — counted against their
# account when signed in, and only against their IP when not. Sized for one
# person: a page view costs two or three API calls, so a student opening a new
# page every few seconds produces 40-50 a minute.
#
# RATE_LIMIT_IP_CEILING_PER_MINUTE is a backstop counted per IP even for
# signed-in callers, closing the gap where one person with several accounts
# would get an allowance each. Set where no legitimate network reaches —
# ~100 students browsing hard behind one NAT is roughly 2,000/min — so if it
# trips, something is wrong. It must be >= RATE_LIMIT_PER_MINUTE; the app
# refuses to start otherwise, because an inverted ceiling would silently put
# every user on a shared network back into a single shared allowance.
#
# Both are in configuration because the defaults are estimates: real traffic is
# what settles them, and tuning should not cost a rebuild.
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_IP_CEILING_PER_MINUTE=3000

# Which addresses in front of this process are proxies we control, as a
# comma-separated list of CIDR ranges or Express presets (loopback, linklocal,
# uniquelocal).
#
# Rate limiting counts requests per client IP. Behind a proxy the connecting
# address is the proxy own and is identical for every visitor, so the real one
# is read from X-Forwarded-For: its entries are walked from the right, skipping
# the ones listed here, stopping at the first that is not. That is the client.
#
# A list rather than a count of hops, because a count cannot be right here: the
# deployment is reachable through two chains of different lengths (via the
# custom domain through Firebase Hosting, and directly via the service own
# .run.app URL), and a count correct for one is wrong -- dangerously so -- for
# the other. Matching on address is correct for both.
#
# The default covers Cloud Run, Firebase Hosting, Google load balancers and the
# local/container networks, so it usually needs no override. Leave empty to
# trust nothing, which is right for a process reached directly.
# TRUST_PROXY_RANGES=loopback,linklocal,uniquelocal,34.96.0.0/12,35.191.0.0/16,130.211.0.0/22,66.249.64.0/19

# --- Email ---------------------------------------------------------------
# MAIL_DRIVER=log prints emails to the application log instead of sending them,
# so the admin-registration/OTP flow works end to end before any mail account
# exists. Refused in production by env validation.
#
# MAIL_DRIVER=resend is what production uses: an HTTPS API rather than an SMTP
# socket, which matters on Cloud Run and similar hosts that block outbound SMTP
# ports, and it reports bounces per message instead of a bare "250 OK".
# Get an API key at https://resend.com/api-keys (it starts `re_`).
#
# MAIL_FROM must use a domain verified in Resend, or the send is rejected —
# add it under https://resend.com/domains and complete the DNS records. Resend
# also provides onboarding@resend.dev for testing before a domain is verified,
# but it can only deliver to the address that owns the Resend account.
#
# MAIL_DRIVER=msg91 sends through MSG91's Email API instead, using the same
# MSG91_AUTH_KEY as SMS. MSG91 only sends dashboard templates, so create ONE
# template under MSG91 → Email → Templates with subject {{subject}} and body
# {{body}}, and put its id in MSG91_EMAIL_TEMPLATE_ID. The emails themselves
# are still written in this repository, so switching drivers never changes
# what people receive. The MAIL_FROM domain must be verified under MSG91 →
# Email → Domains (or set MSG91_EMAIL_DOMAIN if the verified domain differs).
#
# MAIL_DRIVER=smtp remains supported for any provider that speaks SMTP.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your gmail>,
# SMTP_PASSWORD=<a 16-character App Password, NOT your account password>.
# App Passwords require 2-Step Verification to be on:
# https://myaccount.google.com/apppasswords
MAIL_DRIVER=log
MAIL_FROM="JSMF <no-reply@jsmf.local>"
# What the mail plan allows. No provider reports remaining allowance — Resend's
# API returns only a per-second request rate limit — so these are what the
# per-send count log lines ("12/100 today") are measured against. The defaults
# are Resend's free tier; raise both when the plan is upgraded.
# MAIL_DAILY_QUOTA=100
# MAIL_MONTHLY_QUOTA=3000
# RESEND_API_KEY=
# MSG91_EMAIL_TEMPLATE_ID=
# MSG91_EMAIL_DOMAIN=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- SMS (one-time codes) ------------------------------------------------
# The second route a verification code can travel, used when email fails —
# "we couldn't send your code by email, continue with your mobile number".
#
# SMS_DRIVER=none is the default AND a valid production setting: SMS is
# optional, costs money per message, and needs regulatory approval in India.
# It controls more than the transport — with it off, buyers are never OFFERED
# a mobile route at all, which is correct, because offering one that cannot
# send is worse than offering nothing.
#
#   none   no SMS; the mobile alternative is not shown        (default)
#   log    prints codes to the application log for local work; REFUSED in
#          production, because a live one-time code in a log file is a
#          credential sitting in plaintext
#   msg91  the real thing
#
# Before msg91 can work, three things must exist — and the last two involve a
# regulator, not a signup form, so start them early:
#   1. An MSG91 account with credit on it.
#   2. A DLT-registered sender ID (six characters, e.g. JSMFIN).
#   3. A DLT-approved template whose variables are named OTP and EXPIRY:
#        "{{OTP}} is your JSMF verification code. It is valid for {{EXPIRY}}
#         minutes. Do not share it with anyone."
#      MSG91 rejects the send outright if the variable names disagree.
SMS_DRIVER=none
# Assumed when a number is typed without a country code.
# SMS_DEFAULT_COUNTRY_CODE=91
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_SENDER_ID=

# --- WhatsApp (Meta Cloud API) -------------------------------------------
# The preferred phone channel: no DLT needed, arrives with a copy-code button.
#   none  off (default)   log  prints the code; REFUSED in production   meta  real
# For `meta`, see docs/identity/04-whatsapp-and-mobile-sign-in.md §7. Use a
# System User token — the API Setup page's temporary one expires in 24 hours.
# The template must be category Authentication, with a copy-code button and a
# 15-minute code expiry to match the backend.
WHATSAPP_DRIVER=none
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE_NAME=jsmf_verification_code
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# A second, Utility-category template for purchase receipts — sent to buyers
# who have a verified mobile number and no email. Optional: without it those
# buyers simply get no receipt, and the purchase is unaffected. Meta prices and
# approves by category, so the OTP template cannot carry a receipt.
# WHATSAPP_RECEIPT_TEMPLATE_NAME=jsmf_purchase_receipt
# WHATSAPP_RECEIPT_TEMPLATE_LANGUAGE=en

# Where purchase receipts send buyers for their files — the storefront, not
# this API. APP_PUBLIC_URL is the API's own base URL and ends in /api, so using
# it produced receipt links to /api/library, a page that does not exist.
# On Cloud Run: https://store.jsmf.me
STOREFRONT_URL=http://localhost:3001

# --- Live sessions (main website, jsmf.me) ---
# Minutes before a session starts that its reminder email (with the joining
# link) goes out. Swept every 5 minutes, so real send time is up to 5 min later.
SESSION_REMINDER_LEAD_MINUTES=60
# WHATSAPP_GRAPH_API_VERSION=v23.0

# --- Mobile sign-in -------------------------------------------------------
# Whether anyone can sign in or up with a mobile number. Off: no button in any
# client and every /auth/phone route answers 404. To try it locally:
#   PHONE_SIGNIN_ENABLED=true  WHATSAPP_DRIVER=log
# then read the code from the API log. Recreate the container afterwards with
# `npm run docker:dev` — env files are read when a container is created.
PHONE_SIGNIN_ENABLED=false
# Every code costs money, so resends are limited per number as well as per IP.
# PHONE_CODE_RESEND_COOLDOWN_SECONDS=60
# PHONE_CODE_MAX_PER_HOUR=5

# --- Admin onboarding ----------------------------------------------------
# Admins are created by INVITATION from an existing admin — there is no public
# way to request admin access. The invite link is emailed to the invitee and is
# built from this base URL. `npm run db:seed` creates a bootstrap admin only
# when no admin exists at all, which is where the first invitation comes from.
ADMIN_APP_URL=http://localhost:3001

# --- Google sign-in ------------------------------------------------------
# Platform-wide: the same flow serves the PDF platform, the PYQ app, and the
# mobile apps later. Create credentials at
# https://console.cloud.google.com/apis/credentials
#   - Application type: Web application
#   - Authorised redirect URI: must match GOOGLE_CALLBACK_URL exactly
GOOGLE_OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# Signs the OAuth state parameter. Its own secret, not shared with anything else.
OAUTH_STATE_SECRET=replace-with-a-long-random-string
# Front-ends allowed to receive a completed sign-in. An allowlist, not a free
# parameter: an attacker who could choose this would have sessions delivered to
# a site they control. 3000 = PYQ app, 3001 = PDF platform, 3002 = main website (jsmf.me).
OAUTH_ALLOWED_REDIRECTS=http://localhost:3000/auth/callback,http://localhost:3001/auth/callback,http://localhost:3002/auth/callback

# --- Payments -----------------------------------------------------------
# PAYMENT_DRIVER=stub simulates the entire Razorpay lifecycle (order create,
# signature verification, webhook delivery) so checkout can be built and
# tested end to end before a Razorpay account exists. Switch to `razorpay`
# and fill the keys below; no application code changes.
PAYMENT_DRIVER=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard → Settings → Webhooks, set when you create the
# webhook — NOT the API key secret above, and not a value you invent. Boot
# fails if this still looks like a placeholder: a wrong webhook secret rejects
# every notification Razorpay sends, so anyone who closes the tab after paying
# would never receive what they bought, with nothing but a log warning to show
# for it.
RAZORPAY_WEBHOOK_SECRET=
# Used by the stub driver to sign its simulated payloads.
STUB_PAYMENT_SECRET=change-me-dev-only-stub-payment-secret

# The sweep that asks the provider about checkouts no webhook ever reported.
# It is what makes "no payment is ever lost" true rather than aspirational:
# webhooks are delivered over a network to a server that can be redeploying or
# misconfigured, and a buyer who closed the tab sends no callback either.
# Leave it on unless something else runs it — a dedicated worker, or one
# nominated instance if you ever run more than one API container.
PAYMENT_RECONCILIATION_ENABLED=true
# Grace period before an unfinished checkout is worth asking about.
PAYMENT_RECONCILIATION_STALE_AFTER_MINUTES=10
# Past this it is treated as abandoned and stops being polled, so the sweep
# does not re-query every checkout ever started, every five minutes, forever.
PAYMENT_RECONCILIATION_GIVE_UP_AFTER_HOURS=72
PAYMENT_RECONCILIATION_BATCH_SIZE=50
# Where the sweep's clock lives.
#   cron - an in-process timer, every 5 minutes. Correct here and anywhere the
#          container is long-lived (Docker Compose, a VM, min-instances >= 1).
#   http - no timer; Cloud Scheduler POSTs /api/internal/reconcile-payments,
#          authenticated the same way the frontend already calls this backend:
#          a Cloud Run IAM identity token, not an application secret.
# Use `http` on Cloud Run with min-instances=0: a scaled-to-zero service has no
# process for a timer to fire in, and CPU is frozen between requests even when
# one exists. A request is the only thing that reliably wakes it.
PAYMENT_RECONCILIATION_TRIGGER=cron

# --- Seed ---------------------------------------------------------------
# The first admin account, created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@jsmf.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=JSMF Admin
