# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call this API.
# 3000 = the PYQ web app (web/), 3001 = the PDF platform (pdf-web/). They are
# separate Next.js projects, so both need to be listed.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# This API's own public base URL (including /api). Signed download links point
# back here, so in production this must be the real external URL.
APP_PUBLIC_URL=http://localhost:4000/api

# --- Database -----------------------------------------------------------
# Matches docker-compose.yml. `npm run db:up` starts it.
DATABASE_URL=postgresql://jsmf:jsmf@localhost:5433/jsmf?schema=public

# --- Auth (RS256) -------------------------------------------------------
# Access tokens are signed with an RSA private key held ONLY by this service;
# anything else verifies them with the public key (also published at
# GET /api/auth/jwks). That is what lets other JSMF apps — and a future
# standalone auth service — verify tokens without holding the signing key.
#
# Generate a keypair:
#   node -e "const c=require('crypto');const{privateKey:a,publicKey:b}=c.generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log('JWT_PRIVATE_KEY_BASE64='+Buffer.from(a).toString('base64'));console.log('JWT_PUBLIC_KEY_BASE64='+Buffer.from(b).toString('base64'))"
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
# Identifies which key signed a token, so keys can be rotated later without
# invalidating everything in flight.
JWT_KEY_ID=jsmf-identity-1
JWT_ISSUER=jsmf-identity
JWT_AUDIENCE=jsmf
JWT_ACCESS_TTL=15m
# Refresh tokens are opaque random strings (not JWTs) — the database is already
# the source of truth for rotation and revocation.
REFRESH_TOKEN_TTL_DAYS=30

# --- Storage ------------------------------------------------------------
# STORAGE_DRIVER=local writes to .storage/ on disk and serves time-limited
# signed URLs from this API itself — so the whole download/entitlement flow
# works identically before any cloud account exists. Switch to `cloudinary`
# and fill the block below to go live; no application code changes.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage
# Largest single file an admin may upload, in megabytes. 10 matches Cloudinary's
# actual free-plan ceiling on raw uploads (confirmed empirically) — raise this
# only after raising the Cloudinary plan or moving primary-file storage
# elsewhere, or a large file will pass this check and still fail at Cloudinary.
MAX_UPLOAD_SIZE_MB=10
# Secret used to sign local-driver download URLs. Any random string.
STORAGE_SIGNING_SECRET=change-me-dev-only-storage-signing-secret
# How long a download link stays valid.
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Where files are grouped. Folder prefixes on Cloudinary; bucket names if a
# bucket-based provider (GCS/S3) is added later.
STORAGE_PRIVATE_BUCKET=jsmf/private
STORAGE_PUBLIC_BUCKET=jsmf/public

# Cloudinary (only needed when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Redis (off in V1, deliberately) -------------------------------------
# V1 runs without Redis to keep hosting costs down. Nothing in V1 needs it:
# rate-limit counters live in the API process's memory, and there are no
# caches or background job queues yet.
#
# Turn it on (REDIS_ENABLED=true + REDIS_URL) when any of these is true:
#   1. More than one API instance runs — in-memory rate limiting is per
#      process, so N instances silently allow N times the intended limit.
#   2. The first background job is added (exports, bulk ingest, email).
#   3. A read path gets hot enough that Postgres alone is not enough.
#
# Enabling it is this flag and a URL; no application code changes.
# `npm run db:up` starts a local Redis on 6380 for when you do.
REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6380

# --- Email ---------------------------------------------------------------
# MAIL_DRIVER=log prints emails to the application log instead of sending them,
# so the admin-registration/OTP flow works end to end before any mail account
# exists. Refused in production by env validation.
#
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your gmail>,
# SMTP_PASSWORD=<a 16-character App Password, NOT your account password>.
# App Passwords require 2-Step Verification to be on:
# https://myaccount.google.com/apppasswords
MAIL_DRIVER=log
MAIL_FROM="JSMF <no-reply@jsmf.local>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Admin onboarding ----------------------------------------------------
# Admins are created by INVITATION from an existing admin — there is no public
# way to request admin access. The invite link is emailed to the invitee and is
# built from this base URL. `npm run db:seed` creates a bootstrap admin only
# when no admin exists at all, which is where the first invitation comes from.
ADMIN_APP_URL=http://localhost:3001

# --- Google sign-in ------------------------------------------------------
# Platform-wide: the same flow serves the PDF platform, the PYQ app, and the
# mobile apps later. Create credentials at
# https://console.cloud.google.com/apis/credentials
#   - Application type: Web application
#   - Authorised redirect URI: must match GOOGLE_CALLBACK_URL exactly
GOOGLE_OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# Signs the OAuth state parameter. Its own secret, not shared with anything else.
OAUTH_STATE_SECRET=replace-with-a-long-random-string
# Front-ends allowed to receive a completed sign-in. An allowlist, not a free
# parameter: an attacker who could choose this would have sessions delivered to
# a site they control. 3000 = PYQ app, 3001 = PDF platform.
OAUTH_ALLOWED_REDIRECTS=http://localhost:3000/auth/callback,http://localhost:3001/auth/callback

# --- Payments -----------------------------------------------------------
# PAYMENT_DRIVER=stub simulates the entire Razorpay lifecycle (order create,
# signature verification, webhook delivery) so checkout can be built and
# tested end to end before a Razorpay account exists. Switch to `razorpay`
# and fill the keys below; no application code changes.
PAYMENT_DRIVER=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard → Settings → Webhooks, set when you create the
# webhook — NOT the API key secret above, and not a value you invent. Boot
# fails if this still looks like a placeholder: a wrong webhook secret rejects
# every notification Razorpay sends, so anyone who closes the tab after paying
# would never receive what they bought, with nothing but a log warning to show
# for it.
RAZORPAY_WEBHOOK_SECRET=
# Used by the stub driver to sign its simulated payloads.
STUB_PAYMENT_SECRET=change-me-dev-only-stub-payment-secret

# The sweep that asks the provider about checkouts no webhook ever reported.
# It is what makes "no payment is ever lost" true rather than aspirational:
# webhooks are delivered over a network to a server that can be redeploying or
# misconfigured, and a buyer who closed the tab sends no callback either.
# Leave it on unless something else runs it — a dedicated worker, or one
# nominated instance if you ever run more than one API container.
PAYMENT_RECONCILIATION_ENABLED=true
# Grace period before an unfinished checkout is worth asking about.
PAYMENT_RECONCILIATION_STALE_AFTER_MINUTES=10
# Past this it is treated as abandoned and stops being polled, so the sweep
# does not re-query every checkout ever started, every five minutes, forever.
PAYMENT_RECONCILIATION_GIVE_UP_AFTER_HOURS=72
PAYMENT_RECONCILIATION_BATCH_SIZE=50

# --- Seed ---------------------------------------------------------------
# The first admin account, created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@jsmf.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=JSMF Admin
