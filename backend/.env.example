# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# --- Database -----------------------------------------------------------
# Matches docker-compose.yml. `npm run db:up` starts it.
DATABASE_URL=postgresql://jsmf:jsmf@localhost:5433/jsmf?schema=public

# --- Auth ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-change-me-in-production
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret-change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Storage ------------------------------------------------------------
# STORAGE_DRIVER=local writes to .storage/ on disk and serves time-limited
# signed URLs from this API itself — so the whole download/entitlement flow
# works identically before any Google Cloud account exists. Switch to `gcs`
# and fill the block below to go live; no application code changes.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage
# Secret used to sign local-driver download URLs. Any random string.
STORAGE_SIGNING_SECRET=change-me-dev-only-storage-signing-secret
# How long a download link stays valid.
STORAGE_SIGNED_URL_TTL_SECONDS=300

# GCS (only needed when STORAGE_DRIVER=gcs)
GCS_PROJECT_ID=
GCS_PRIVATE_BUCKET=jsmf-private-content
GCS_PUBLIC_BUCKET=jsmf-public-assets
# Path to the service-account JSON key file.
GCS_KEY_FILE=

# --- Payments -----------------------------------------------------------
# PAYMENT_DRIVER=stub simulates the entire Razorpay lifecycle (order create,
# signature verification, webhook delivery) so checkout can be built and
# tested end to end before a Razorpay account exists. Switch to `razorpay`
# and fill the keys below; no application code changes.
PAYMENT_DRIVER=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Used by the stub driver to sign its simulated payloads.
STUB_PAYMENT_SECRET=change-me-dev-only-stub-payment-secret

# --- Seed ---------------------------------------------------------------
# The first admin account, created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@jsmf.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=JSMF Admin
