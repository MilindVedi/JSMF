# Where PYQ data comes from: `api` (the NestJS backend through this app's /api
# proxy) or `mock` (self-contained demo data, no backend needed). Leaving it
# unset means mock.
# Inlined at build time, so changing it needs a rebuild.
NEXT_PUBLIC_DATA_SOURCE=api

# The NestJS backend the /api proxy forwards to (same name as main-web).
# A trailing /api is tolerated and stripped.
BACKEND_API_URL=http://localhost:4000

# Optional pre-launch Basic Auth gate for every page (not /api). Leave either
# unset to disable it, e.g. for local development.
MOCK_UI_BASIC_AUTH_USER=
MOCK_UI_BASIC_AUTH_PASSWORD=

# The public address, for share previews and absolute URLs.
NEXT_PUBLIC_SITE_URL=https://pyqs.jsmf.me
