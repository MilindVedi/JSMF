# Dev-mode image: installs dependencies, then hands off to `next dev`. Source
# is bind-mounted at runtime (see ../docker-compose.dev.yml), so edits on the
# host are picked up by Next's own file watcher with no rebuild.
FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 3001
CMD ["npm", "run", "dev"]
