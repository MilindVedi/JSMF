# Copy to .env.local. Both are gitignored.

# The JSMF backend API. Used by the Next.js server to proxy /api requests.
BACKEND_API_URL=http://localhost:4000

# The one public address the site is published at, used for the canonical URL
# and for absolute links in page metadata (Open Graph, etc).
#
# It has to be configured rather than read from the request, because the app
# answers on more than one hostname and Firebase Hosting rewrites the Host
# header to the *.run.app name on the way through — so the running container
# always sees the Cloud Run URL, never the domain a visitor actually typed.
# Unset falls back to localhost, which is right for local dev and wrong
# everywhere else: set this on every deployed environment.
NEXT_PUBLIC_SITE_URL=https://store.jsmf.me

# Largest file the admin panel will attempt to upload, in megabytes. Keep this
# <= the backend's MAX_UPLOAD_SIZE_MB — that one matches Cloudinary's actual
# hard ceiling for raw uploads (10 MB on the free plan), and the browser check
# exists only so an oversized file fails in a second instead of after a long
# upload. The server rejects it independently either way.
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# Optional: HTTP Basic Auth gate for the deployed preview. If either is unset,
# the gate is skipped entirely (so local dev needs no setup).
MOCK_UI_BASIC_AUTH_USER=
MOCK_UI_BASIC_AUTH_PASSWORD=
