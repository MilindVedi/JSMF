# Copy to .env.local. Both are gitignored.

# The JSMF backend API, including its /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Largest file the admin panel will attempt to upload, in megabytes. Keep this
# <= the backend's MAX_UPLOAD_SIZE_MB — that one matches Cloudinary's actual
# hard ceiling for raw uploads (10 MB on the free plan), and the browser check
# exists only so an oversized file fails in a second instead of after a long
# upload. The server rejects it independently either way.
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# Optional: HTTP Basic Auth gate for the deployed preview. If either is unset,
# the gate is skipped entirely (so local dev needs no setup).
MOCK_UI_BASIC_AUTH_USER=
MOCK_UI_BASIC_AUTH_PASSWORD=
